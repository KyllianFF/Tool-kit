# The build output is committed on purpose: dist/toolkit.ps1 is the file the
# one liner downloads. Everything else a build or an editor produces is not.
dist/*.tmp
dist/*.bak

# Portable build outputs, produced on demand by build/New-PortablePackage.ps1.
dist/Toolkit-Portable-*
dist/Toolkit-*.ps1
dist/Toolkit-*.ps1.sha256
dist/signing/

# PowerShell
*.ps1.bak

# Editors
.vs/
.vscode/*
!.vscode/extensions.json
*.suo
*.user

# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Local scratch
scratch/
tmp/
*.log
