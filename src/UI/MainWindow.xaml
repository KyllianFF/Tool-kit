                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="A 0x, 0b or 0o prefix sets the base; without one the base chosen here is used. Spaces and underscores are grouping. The result shows every base and the bits that are set, so a value such as a userAccountControl or an SDDL mask can be read bit by bit." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="NumberOutput" Style="{StaticResource Mono}" IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                </Border>
                            </Grid>

                            <Grid x:Name="ToolDataSize" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Data size and transfer time" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="DataSizeInput" Width="180" Margin="0,0,16,0"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" Tag="25 GB, 500 MiB" />
