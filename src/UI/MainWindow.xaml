                                            <TextBox x:Name="SchtaskModifier" Width="80" Margin="0,0,16,8"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" Tag="1" />
                                            <TextBlock Text="At /ST" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="SchtaskStartTime" Width="90" Margin="0,0,16,8" Text="02:00"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" />
                                            <TextBlock Text="Day /D" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="SchtaskDay" Width="90" Margin="0,0,0,8"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" Tag="MON or 15" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="Run as /RU" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="SchtaskRunAs" Width="150" Margin="0,0,16,0"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" Tag="SYSTEM" />
                                            <CheckBox x:Name="SchtaskHighest" Content="Highest privileges" Margin="0,0,16,0" VerticalAlignment="Center" />
                                            <CheckBox x:Name="SchtaskForce" Content="Overwrite (/F)" IsChecked="True" Margin="0,0,16,0" VerticalAlignment="Center" />
                                            <Button x:Name="BtnCopySchtask" Content="Copy the command" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="Only the fields a schedule uses are added: a day for weekly and monthly, a start time for the timed schedules. Highest privileges runs the task elevated. Run as SYSTEM needs no password." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="SchtaskOutput" Style="{StaticResource Mono}" IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                </Border>
