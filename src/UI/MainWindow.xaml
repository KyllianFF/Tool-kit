                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="E-mail header analyser" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <TextBox x:Name="MailHeaderInput" Height="140" Margin="0,0,0,8"
