                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="A capital B is bytes, a small b is bits, as networking writes them; KB is a thousand, KiB is 1024. The size is shown in both, and the transfer time is given at the full rate and at ninety percent, since a real link rarely reaches its advertised speed." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="DataSizeOutput" Style="{StaticResource Mono}" IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                </Border>
                            </Grid>

