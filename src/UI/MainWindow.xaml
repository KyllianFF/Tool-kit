                            <Grid x:Name="ToolRegex" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Regular expression tester" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern" VerticalAlignment="Center" Margin="0,0,12,8" />
                                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="RegexPattern" Margin="0,0,0,8"
                                                       FontFamily="Cascadia Mono, Consolas, Courier New" Tag="For example (?&lt;user&gt;[\w.]+)@(?&lt;domain&gt;[\w.]+)" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Replace with" VerticalAlignment="Center" Margin="0,0,12,8" />
                                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="RegexReplacement" Margin="0,0,0,8"
                                                       FontFamily="Cascadia Mono, Consolas, Courier New" Tag="Optional: $1 or ${name} for a group" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Text" VerticalAlignment="Top" Margin="0,8,12,8" />
                                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="RegexText" Height="110" Margin="0,0,0,8"
                                                       AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                       FontFamily="Cascadia Mono, Consolas, Courier New" Tag="The text to search" />
                                        </Grid>
                                        <WrapPanel>
                                            <CheckBox x:Name="RegexIgnoreCase" Content="Ignore case" Margin="0,0,16,0" />
                                            <CheckBox x:Name="RegexMultiline" Content="^ and $ match at each line" Margin="0,0,16,0" />
                                            <CheckBox x:Name="RegexSingleline" Content="The dot matches new lines" Margin="0,0,16,0" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="Tested as you type, with the .NET flavour that -match and -replace use: named groups, lookbehind, \d and \w matching Unicode. A test stops after 2 seconds, so a pattern that backtracks without end cannot freeze the window." />
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="340" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                                        <TextBox x:Name="RegexOutput" Style="{StaticResource Mono}" IsReadOnly="True"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 AcceptsReturn="True" />
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Cheat sheet, double-click to insert" Style="{StaticResource SubHeading}" Margin="0,0,0,6" />
                                            <ListBox Grid.Row="1" x:Name="RegexCheatSheet" Background="Transparent" BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12"
                                                     Foreground="{DynamicResource TextPrimary}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid x:Name="ToolTimestamps" Visibility="Collapsed">
