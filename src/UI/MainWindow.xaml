                                                     FontFamily="Cascadia Mono, Consolas, Courier New" Tag="CONTOSO\Helpdesk" />
                                            <CheckBox x:Name="DsaclsDeny" Content="Deny instead of grant (/D)" VerticalAlignment="Center" Margin="0,0,0,8"
                                                      ToolTip="Deny the rights rather than grant them. A deny wins over any grant." />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,0,0,4" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="20000">
                                            <TextBlock Text="Task" VerticalAlignment="Center" Margin="0,0,8,8"
                                                       ToolTip="What to delegate. Each task fills in the dsacls permission letters for you." />
                                            <ComboBox x:Name="DsaclsPreset" Width="260" MinHeight="40" Margin="0,0,16,8" />
                                            <TextBlock Text="On object type" VerticalAlignment="Center" Margin="0,0,8,8"
                                                       ToolTip="The kind of child object the rights apply to. All objects leaves the type out." />
                                            <ComboBox x:Name="DsaclsObjectType" Width="160" MinHeight="40" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,0,0,4" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="20000">
                                            <TextBlock Text="Reaches" VerticalAlignment="Center" Margin="0,0,8,8"
                                                       ToolTip="How far the rights inherit: /I:T this object and all children, /I:S child objects only, /I:P this object and its immediate children, or this object only." />
                                            <ComboBox x:Name="DsaclsInheritance" Width="280" MinHeight="40" Margin="0,0,16,8" />
                                            <TextBlock Text="Custom rights" VerticalAlignment="Center" Margin="0,0,8,8"
                                                       ToolTip="Used only with the Custom task: the dsacls rights after the colon, such as CCDC;computer or WPRP;member;group." />
                                            <TextBox x:Name="DsaclsCustom" Width="200" Margin="0,0,16,8"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" Tag="CCDC;computer" />
