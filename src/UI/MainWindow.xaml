                                                 Tag="O:BAG:BAD:(A;;FA;;;SY)(A;;FR;;;BU) - or the output of sc.exe sdshow, or a Get-Acl Sddl" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="The owner, group and each access control entry are named. The low bits of an access mask mean different things on a file, a registry key, a directory object or a service, so the kind of object is chosen above." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="SddlOutput" Style="{StaticResource Mono}" IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                </Border>
                            </Grid>

                            <Grid x:Name="ToolAdFlags" Visibility="Collapsed">
