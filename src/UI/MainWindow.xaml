                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Active Directory account flags" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <ComboBox x:Name="AdFlagAttribute" Width="240" MinHeight="40" Margin="0,0,16,0" />
