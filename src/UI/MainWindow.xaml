<!--
    Toolkit - Main window

    Loaded at run time with XamlReader, which imposes two rules on this file:

      - no x:Class attribute, because there is no compiled code behind;
      - no event handler attributes, because XamlReader cannot resolve them.
        Every handler is attached from PowerShell through FindName.

    Layout: a fixed header, a navigation rail, one panel per feature area of
    which exactly one is visible, a collapsible output console and a status
    bar. Colours are declared once as resources so a light theme is a
    resource swap rather than a rewrite.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Toolkit"
    Height="820" Width="1320"
    MinHeight="640" MinWidth="1080"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource AppBackground}">

    <Window.Resources>

        <!--
            Palette.

            Declared once here as the dark values and swapped at run time by
            Set-TkTheme, which replaces the brush objects behind these keys.
            Every control below refers to them with DynamicResource, never
            with a literal colour, so a theme change repaints the whole
            window without rebuilding it.

            Never hard code a colour on a control. The previous version did
            that for the combo boxes and list views, which left black text on
            a dark background in half the interface.
        -->
        <SolidColorBrush x:Key="AppBackground"   Color="#16181D" />
        <SolidColorBrush x:Key="Surface"         Color="#1E2128" />
        <SolidColorBrush x:Key="SurfaceRaised"   Color="#262A33" />
        <SolidColorBrush x:Key="InputBackground" Color="#12141A" />
        <SolidColorBrush x:Key="BorderSubtle"    Color="#333845" />
        <SolidColorBrush x:Key="TextPrimary"     Color="#E7EAF0" />
        <SolidColorBrush x:Key="TextMuted"       Color="#98A1B2" />
        <SolidColorBrush x:Key="Accent"          Color="#4C8DFF" />
        <SolidColorBrush x:Key="AccentMuted"     Color="#2A4C8A" />
        <SolidColorBrush x:Key="Selection"       Color="#2F3A4F" />
        <SolidColorBrush x:Key="RowAlternate"    Color="#252932" />
        <SolidColorBrush x:Key="Success"         Color="#3FB950" />
        <SolidColorBrush x:Key="Warning"         Color="#D29922" />
        <SolidColorBrush x:Key="Danger"          Color="#F85149" />

        <!-- ============================ Icons ============================
            Segoe Fluent Icons ships with Windows 11 and Segoe MDL2 Assets
            with Windows 10, so the glyphs cost nothing to distribute: no
            image files, no download, and they take the foreground colour of
            whatever draws them, which means they follow a theme change for
            free. The fallback order covers both releases.

            Every code point below was chosen by rendering the font inventory
            and looking at it. Guessing one produces an empty box.
        -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize"   Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment"   Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment"       Value="Center" />
        </Style>

        <!-- The glyph that leads a button label. -->
        <Style x:Key="ButtonGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin"   Value="0,0,7,0" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- ============================ Text ============================ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize"   Value="13" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin"     Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin"     Value="0,14,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize"     Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--
            Styles for use inside a DataTemplate.

            An implicit style does not reach into a DataTemplate: a TextBlock
            declared there with no Style of its own falls back to the system
            default and renders black, which is unreadable on the dark theme.
            That is exactly what happened to the item titles on the Software,
            Tweaks and Fixes lists. Every element inside a template therefore
            names its style explicitly.
        -->
        <Style x:Key="ItemTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ItemText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" />

        <Style x:Key="ItemBadge" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize"   Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <Style x:Key="ItemState" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Success}" />
        </Style>

        <Style x:Key="ItemCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}" />

        <Style x:Key="ItemButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />

        <!--
            The coloured square that opens a list row.

            Its fill is an identity colour set from the page code, deliberately
            outside the palette: it has to mean the same thing in both themes.
            Each one is dark enough to carry a white glyph, which is why the
            glyph colour is literal here and nowhere else.
        -->
        <Style x:Key="ItemTile" TargetType="Border">
            <Setter Property="Width"        Value="34" />
            <Setter Property="Height"       Value="34" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"       Value="0,0,11,0" />
        </Style>

        <Style x:Key="TileGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize"   Value="16" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!--
            A selectable card. The border and a tinted fill carry the selected
            state, with a tick on the right, so the whole row reads as chosen
            rather than a small box in the corner being ticked.
        -->
        <Style x:Key="AppCard" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor"    Value="Hand" />
            <Setter Property="Margin"    Value="4,3" />
            <Setter Property="Padding"   Value="10,7" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="8"
                                Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextMuted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"     Value="{DynamicResource Accent}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Chrome" Property="Background"      Value="{DynamicResource Selection}" />
                                <Setter TargetName="Chrome" Property="Padding"         Value="9,6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A card that is itself the action.

            The same shape as AppCard, but a Button rather than a ToggleButton
            because a fix is run, not selected. It replaces a small Run button
            at the end of the row: the row was already the thing you were
            reading and pointing at, so making the row the target removes a
            second, smaller one. The chevron on the right says so, and the
            border lighting up under the pointer confirms it.

            Disabled state matters here. A fix that needs rights this instance
            does not have is greyed whole, with the reason in its tooltip,
            rather than accepting the click and refusing afterwards.
        -->
        <Style x:Key="ActionCard" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor"     Value="Hand" />
            <Setter Property="Margin"     Value="4,3" />
            <Setter Property="Padding"    Value="12,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="8"
                                Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Chrome" Property="Background"  Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentMuted}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A report chooser entry. Eight buttons in a row is a toolbar, and a
            toolbar is the wrong shape for "pick one of these to run": nothing
            says which is selected, and there is no room for the one line that
            explains what each one does. A list has both.
        -->
        <Style x:Key="ReportChoice" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin"  Value="0,0,0,3" />
            <Setter Property="Cursor"  Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" CornerRadius="6"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1,1,1,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background"  Value="{DynamicResource Selection}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize"   Value="13" />
        </Style>

        <Style x:Key="ChoiceHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground"   Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize"     Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin"       Value="0,2,0,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Margin"     Value="0,0,0,2" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize"     Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin"       Value="0,0,0,12" />
        </Style>

        <!-- =========================== Buttons =========================== -->
        <Style TargetType="Button">
            <!--
                A tooltip on a disabled control is hidden by default, which
                defeats the one case it is most needed for: a greyed action
                whose tooltip is the explanation of why it is greyed. Set
                here so every button in the application inherits it, styles
                based on this one included.
            -->
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Background"      Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="14,7" />
            <Setter Property="Margin"          Value="0,0,8,0" />
            <Setter Property="FontFamily"      Value="Segoe UI" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"  Value="{DynamicResource AccentMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight"  Value="SemiBold" />
        </Style>

        <!--
            A button that leads with an icon.

            The glyph comes from Tag rather than from a nested TextBlock in
            the content, because a TextBlock declared in content picks up the
            implicit style and its explicit Foreground, which overrides the
            inherited one and leaves a label in the wrong colour on the accent
            fill. Read from the template, it takes the button's own
            foreground and stays correct in both themes and when disabled.

            Only for buttons whose Tag is free. The ones that carry an
            identifier in Tag, such as the fix runners, keep the plain style.
        -->
        <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="14"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlyphPrimaryButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
            <Setter Property="Background"  Value="{DynamicResource AccentMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight"  Value="SemiBold" />
        </Style>

        <!--
            Actions that all operate on the field beside them.

            A loose row of buttons after a text box says nothing about which
            of them uses it, and the network tabs had three or four per row
            with no visual tie to their input at all. Enclosing them in one
            container makes the relationship structural: this box holds the
            things you can do to that field. A divider between them keeps
            them readable as separate actions rather than one long strip.
        -->
        <Style x:Key="ActionGroup" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="6" />
            <Setter Property="Padding"         Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment"   Value="Center" />
            <Setter Property="Margin"          Value="12,0,0,0" />
        </Style>

        <Style x:Key="GroupedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin"          Value="0" />
            <Setter Property="Padding"         Value="13,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentMuted}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The action a group runs if you only press one thing. -->
        <Style x:Key="GroupedPrimaryButton" TargetType="Button" BasedOn="{StaticResource GroupedButton}">
            <Setter Property="Background" Value="{DynamicResource AccentMuted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GroupDivider" TargetType="Rectangle">
            <Setter Property="Width"  Value="1" />
            <Setter Property="Fill"   Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Margin" Value="2,7" />
        </Style>

        <!-- The label in front of a form field. Kept to one width per tab
             with SharedSizeGroup, so the fields line up down the card. -->
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground"        Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize"          Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="0,0,12,0" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"          Value="Transparent" />
            <Setter Property="BorderThickness"     Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding"             Value="16,11" />
            <Setter Property="Margin"              Value="8,2,8,2" />
            <Setter Property="FontSize"            Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="16"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           Width="24" />
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================== Text entry ========================== -->
        <!--
            The default text box carries a hint: whatever is in its Tag is
            shown, greyed, while the box is empty. A field that does not say
            what belongs in it is a field nobody fills in correctly, and the
            configuration tab has a row of them.
        -->
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="8,6" />
            <Setter Property="FontFamily"      Value="Segoe UI" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush"  Value="{DynamicResource Accent}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="9,6,9,6"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           FontSize="{TemplateBinding FontSize}"
                                           IsHitTestVisible="False" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Text that can be selected and copied but looks like a label.

            A TextBlock cannot be selected on .NET Framework, and a table
            nobody can copy a thumbprint or a path out of is half a table. A
            read only TextBox behaves correctly, but the implicit style above
            would give it a border, a fill and a hint, so it needs a template
            of its own.

            The template must contain a ScrollViewer named PART_ContentHost:
            that is where TextBoxBase renders the text. Clearing the template
            instead leaves the control with no visual tree at all, which is
            not an invisible border but an invisible control. Every table and
            every finding card rendered blank until this replaced it.
        -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly"      Value="True" />
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="FontFamily"      Value="Segoe UI" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="TextWrapping"    Value="Wrap" />
            <Setter Property="IsTabStop"       Value="False" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush"  Value="{DynamicResource Accent}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility"   Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background"      Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="8,6" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimary}" />
        </Style>

        <!--
            Output boxes reuse the same template. It respects the control's
            alignment and scroll bar settings, so the one line fields stay
            centred and the reports scroll.
        -->
        <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FontFamily"     Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize"       Value="12" />
            <Setter Property="IsReadOnly"     Value="True" />
            <Setter Property="Background"     Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground"     Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"    Value="{DynamicResource BorderSubtle}" />
            <Setter Property="CaretBrush"     Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="TextWrapping"   Value="NoWrap" />
        </Style>

        <!-- ========================== CheckBox ========================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                <Path x:Name="Tick" Stretch="Uniform" Margin="3"
                                      Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Data="M 0 4 L 3 7 L 8 1" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box"  Property="Background"  Value="{DynamicResource AccentMuted}" />
                                <Setter TargetName="Box"  Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility"  Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================== ComboBox ==========================
             A full template is required. The stock one paints its own popup
             and toggle chrome from system colours, so setting Background and
             Foreground alone leaves a white drop-down with black text in the
             middle of a dark window.
        -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding"    Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="8,6" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" CornerRadius="5"
                                                Background="{DynamicResource InputBackground}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource TextMuted}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="10,0,26,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{DynamicResource TextPrimary}" />

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320" CornerRadius="5"
                                        Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ====================== Lists and grids ======================= -->
        <Style TargetType="ListBox">
            <Setter Property="Background"      Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding"    Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The list view styles that used to live here are gone with the last
            GridView. Every table in the application is now built by
            Add-TkTable, which gives selectable cells, banded rows, draggable
            column edges and live theme following from one place. Keeping a
            second table mechanism meant fixing each of those twice, and the
            column resize handle went missing from one of them for exactly
            that reason.
        -->

        <!-- ========================= TabControl ========================= -->
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Padding="16,9" Margin="0,0,4,0"
                                CornerRadius="6,6,0,0" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background"  Value="{DynamicResource Surface}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================== Expander ========================== -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
        </Style>

        <Style TargetType="RichTextBox">
            <Setter Property="Foreground"     Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background"     Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontFamily"     Value="Segoe UI" />
            <Setter Property="FontSize"       Value="13" />
        </Style>

        <!-- ============================ Card ============================ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="16" />
            <Setter Property="Margin"          Value="0,0,0,12" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================= Header ============================= -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Toolkit" FontSize="19" FontWeight="Bold" />
                    <TextBlock x:Name="HeaderVersion" Text="v1.0.0" Style="{StaticResource Muted}"
                               Margin="10,0,0,0" VerticalAlignment="Bottom" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="HeaderHost" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Theme" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ThemeSelect" Width="110" Margin="0,0,14,0" />
                    <Border x:Name="ElevationBadge" CornerRadius="4" Padding="10,4" Margin="0,0,10,0"
                            Background="{DynamicResource SurfaceRaised}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <TextBlock x:Name="ElevationText" Text="Standard user" FontSize="12" />
                    </Border>
                    <Button x:Name="BtnElevate" Content="Restart as administrator" Style="{StaticResource GlyphPrimaryButton}" Tag="&#xEA18;" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== Body ============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Top" Margin="0,12,0,0">
                        <!-- Tag carries the icon code point; see the IconFont note above. -->
                        <Button x:Name="NavSystem"      Content="System"      Style="{StaticResource NavButton}" Tag="&#xEC4E;" />
                        <Button x:Name="NavSoftware"    Content="Software"    Style="{StaticResource NavButton}" Tag="&#xECA5;" />
                        <Button x:Name="NavTweaks"      Content="Tweaks"      Style="{StaticResource NavButton}" Tag="&#xE9E9;" />
                        <Button x:Name="NavFixes"       Content="Fixes"       Style="{StaticResource NavButton}" Tag="&#xE90F;" />
                        <Button x:Name="NavNetwork"     Content="Network"     Style="{StaticResource NavButton}" Tag="&#xEC26;" />
                        <Button x:Name="NavDiagnostics" Content="Diagnostics" Style="{StaticResource NavButton}" Tag="&#xE95E;" />
                        <Button x:Name="NavHardware"    Content="Hardware"    Style="{StaticResource NavButton}" Tag="&#xE977;" />
                        <Button x:Name="NavSecurity"    Content="Security"    Style="{StaticResource NavButton}" Tag="&#xEA18;" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                        <Button x:Name="BtnOpenLogs" Content="Open log folder" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                        <Button x:Name="BtnAbout"    Content="About"           HorizontalAlignment="Stretch" Margin="0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Feature panels. Exactly one is visible at a time. -->
            <Grid Grid.Column="1" x:Name="PageHost">

                <!-- ========================= SYSTEM ========================= -->
                <ScrollViewer x:Name="PageSystem" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Visible">
                    <StackPanel>
                        <TextBlock Text="System" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Machine identity read from SMBIOS, operating system state and platform security posture. Everything on this page is read only and works without elevation." />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,4">
                            <Button x:Name="BtnRefreshSystem" Content="Refresh" Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE72C;" />
                            <Button x:Name="BtnCopySerial"    Content="Copy serial number" Style="{StaticResource GlyphButton}" Tag="&#xE8C8;" />
                            <Button x:Name="BtnVendorDrivers" Content="Vendor drivers" />
                            <Button x:Name="BtnVendorWarranty" Content="Warranty" />
                            <Button x:Name="BtnVendorTool"    Content="Install firmware utility" />
                            <Button x:Name="BtnExportReport"  Content="Export report" Style="{StaticResource GlyphButton}" Tag="&#xE74E;" />
                        </StackPanel>

                        <!-- Identity -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,12">
                            <StackPanel>
                                <TextBlock Text="Identity" Style="{StaticResource SubHeading}" Margin="0,0,0,10" />
                                <UniformGrid Columns="4" x:Name="IdentityGrid">
                                    <StackPanel><TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValManufacturer" Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Model"        Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValModel"        Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Serial number" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValSerial"      Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Asset tag"    Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValAssetTag"     Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Chassis"      Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValChassis"      Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Motherboard"  Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBoard"        Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Domain"       Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValDomain"       Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Signed in user" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValUser"       Style="{StaticResource FieldValue}" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Firmware -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Firmware" Style="{StaticResource SubHeading}" Margin="0,0,0,10" />
                                <UniformGrid Columns="4">
                                    <StackPanel><TextBlock Text="BIOS vendor"  Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBiosVendor"  Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="BIOS version" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBiosVersion" Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Release date" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBiosDate"    Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Age"          Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBiosAge"     Style="{StaticResource FieldValue}" /></StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="ValBiosAdvice" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                           Text="The toolkit never downloads or flashes firmware itself. It installs the vendor utility and opens the support page pre-filled with this serial number." />
                            </StackPanel>
                        </Border>

                        <!-- Operating system -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Operating system" Style="{StaticResource SubHeading}" Margin="0,0,0,10" />
                                <UniformGrid Columns="4">
                                    <StackPanel><TextBlock Text="Edition"    Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValOsCaption"  Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Version"    Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValOsVersion"  Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Build"      Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValOsBuild"    Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Activation" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValActivation" Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Installed"  Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValInstalled"  Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Uptime"     Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValUptime"     Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Time zone"  Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValTimeZone"   Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="PowerShell" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValPowerShell" Style="{StaticResource FieldValue}" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Hardware -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Hardware" Style="{StaticResource SubHeading}" Margin="0,0,0,10" />
                                <UniformGrid Columns="4">
                                    <StackPanel><TextBlock Text="Processor" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValCpu"      Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Cores"     Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValCores"    Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Memory"    Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValMemory"   Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Graphics"  Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValGpu"      Style="{StaticResource FieldValue}" /></StackPanel>
                                </UniformGrid>

                                <!--
                                    Rendered by the shared table builder
                                    rather than a GridView. One renderer
                                    means one set of behaviours everywhere:
                                    selectable cells, banded rows, draggable
                                    column edges and a palette that follows a
                                    theme change. A GridView gives none of
                                    those without a template per column.
                                -->
                                <TextBlock Text="Volumes" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                                <RichTextBox x:Name="DocVolumes" IsReadOnly="True" MaxHeight="200"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled" />

                                <TextBlock Text="Physical disks" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                <RichTextBox x:Name="DocDisks" IsReadOnly="True" MaxHeight="200"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled" />
                            </StackPanel>
                        </Border>

                        <!-- Platform security -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Platform security" Style="{StaticResource SubHeading}" Margin="0,0,0,10" />
                                <UniformGrid Columns="2">
                                    <StackPanel><TextBlock Text="Secure Boot" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValSecureBoot" Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="TPM"         Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValTpm"        Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="BitLocker"   Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBitLocker"  Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Firewall"    Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValFirewall"   Style="{StaticResource FieldValue}" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================== SOFTWARE ======================== -->
                <Grid x:Name="PageSoftware" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Software" Style="{StaticResource Heading}" />
                        <TextBlock x:Name="WingetStatusText" Style="{StaticResource Muted}"
                                   Text="Installation through winget, from the official Microsoft source only." />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="SoftwareSearch" Tag="Search applications by name, description or package id" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" x:Name="SoftwareCategory" Width="200" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnInstallSelected"   Content="Install selected" Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE896;" />
                            <Button x:Name="BtnUninstallSelected" Content="Uninstall"        Style="{StaticResource GlyphButton}" Tag="&#xE74D;" />
                            <Button x:Name="BtnUpgradeAll"        Content="Upgrade all"      Style="{StaticResource GlyphButton}" Tag="&#xE895;" />
                            <Button x:Name="BtnRefreshInstalled"  Content="Refresh state"    Style="{StaticResource GlyphButton}" Tag="&#xE72C;" />
                            <Button x:Name="BtnClearSelection"    Content="Clear"            Style="{StaticResource GlyphButton}" Tag="&#xE711;" Margin="0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SoftwareList">
                                <!--
                                    Two columns when there is room for two,
                                    one when there is not. A hundred and forty
                                    full width rows is a lot of scrolling for
                                    a list whose entries are a name and a
                                    line of description; Initialize-TkSoftware
                                    Page sets Columns from the panel width.
                                -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid x:Name="SoftwarePanel" Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            The whole card is the toggle. A
                                            checkbox in the corner makes a
                                            large clickable area behave like a
                                            small one, and selecting twenty
                                            applications means twenty small
                                            targets instead of twenty large.
                                        -->
                                        <ToggleButton Style="{StaticResource AppCard}"
                                                      ToolTip="{Binding PackageId}">
                                            <ToggleButton.IsChecked>
                                                <Binding Path="IsSelected" Mode="TwoWay" />
                                            </ToggleButton.IsChecked>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--
                                                    The real publisher icon
                                                    when the catalogue has
                                                    one, the category icon
                                                    otherwise. Exactly one of
                                                    the two is ever visible.
                                                -->
                                                <Border Grid.Column="0" Style="{StaticResource ItemTile}"
                                                        Background="{Binding TileBrush}">
                                                    <Grid>
                                                        <TextBlock x:Name="CategoryGlyph"
                                                                   Text="{Binding Glyph}"
                                                                   Style="{StaticResource TileGlyph}" />
                                                        <Path x:Name="BrandIcon"
                                                              Data="{Binding IconGeometry}"
                                                              Fill="White" Stretch="Uniform"
                                                              Width="17" Height="17"
                                                              Visibility="Collapsed"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <!--
                                                        The package identifier
                                                        moved to the card's
                                                        tooltip: it is what
                                                        you check once, not
                                                        what you read down a
                                                        list.
                                                    -->
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}"
                                                               Style="{StaticResource ItemState}"
                                                               VerticalAlignment="Center" Margin="8,0,8,0" />
                                                    <Path x:Name="SelectedMark" Width="14" Height="14"
                                                          Stretch="Uniform" Visibility="Hidden"
                                                          Fill="{DynamicResource Accent}"
                                                          Data="M 6 11.2 L 1.8 7 L 0.4 8.4 L 6 14 L 18 2 L 16.6 0.6 Z" />
                                                </StackPanel>
                                            </Grid>
                                        </ToggleButton>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                <Setter TargetName="BrandIcon"     Property="Visibility" Value="Visible" />
                                                <Setter TargetName="CategoryGlyph" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ========================= TWEAKS ========================= -->
                <Grid x:Name="PageTweaks" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Tweaks" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Every tweak declares both the applied state and the state to restore, so each one can be reverted. A system restore point is created before a batch is applied." />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="TweakSearch" Tag="Search tweaks" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" x:Name="TweakCategory" Width="200" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnApplyTweaks"   Content="Apply selected" Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE73E;" />
                            <Button x:Name="BtnRevertTweaks"  Content="Revert selected" Style="{StaticResource GlyphButton}" Tag="&#xE7A7;" />
                            <Button x:Name="BtnRefreshTweaks" Content="Refresh state"  Style="{StaticResource GlyphButton}" Tag="&#xE72C;" Margin="0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TweakList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            Same card as the Software list:
                                            the whole row is the toggle. Two
                                            lists that do the same thing
                                            should not be operated in two
                                            different ways.
                                        -->
                                        <ToggleButton Style="{StaticResource AppCard}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource ItemTile}"
                                                        Background="{Binding TileBrush}">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource TileGlyph}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                                        <Border CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                                                                Background="{DynamicResource Surface}"
                                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                            <TextBlock Text="{Binding Impact}" Style="{StaticResource ItemBadge}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}"
                                                               Style="{StaticResource ItemState}"
                                                               VerticalAlignment="Center" Margin="12,0,10,0" />
                                                    <Path x:Name="SelectedMark" Width="15" Height="15"
                                                          Stretch="Uniform" Visibility="Hidden"
                                                          Fill="{DynamicResource Accent}"
                                                          Data="M 6 11.2 L 1.8 7 L 0.4 8.4 L 6 14 L 18 2 L 16.6 0.6 Z" />
                                                </StackPanel>
                                            </Grid>
                                        </ToggleButton>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ========================== FIXES ========================== -->
                <Grid x:Name="PageFixes" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Fixes" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Repair actions with the symptom each one addresses. Read the note before running anything marked high risk." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="BtnAutoLogon"     Content="Automatic logon" Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE8D7;" />
                            <Button x:Name="BtnRestorePoint"  Content="Create a restore point" Style="{StaticResource GlyphButton}" Tag="&#xE74E;" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FixList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            The same card shape as Software
                                            and Tweaks, but a plain border
                                            rather than a toggle: a fix is
                                            run, not selected, so there is
                                            nothing for a checked state to
                                            mean. The Run button keeps the
                                            plain style because its Tag
                                            carries the fix identifier.
                                        -->
                                        <Button Style="{StaticResource ActionCard}"
                                                Tag="{Binding Id}"
                                                IsEnabled="{Binding CanRun}"
                                                ToolTip="{Binding RunTooltip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource ItemTile}"
                                                        Background="{Binding TileBrush}">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource TileGlyph}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                                        <Border CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                                                                Background="{DynamicResource Surface}"
                                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource ItemBadge}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding WhenToUse}" Style="{StaticResource Muted}"
                                                               Margin="0,3,0,0" FontStyle="Italic" Opacity="0.8" />
                                                </StackPanel>

                                                <!-- Says the row is the target. -->
                                                <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                           Style="{StaticResource Glyph}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           VerticalAlignment="Center" Margin="4,0,2,0" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ========================= NETWORK ========================= -->
                <Grid x:Name="PageNetwork" Margin="24,20" Visibility="Collapsed">
                    <TabControl x:Name="NetworkTabs" Background="Transparent" BorderThickness="0">

                        <TabItem Header="Subnet calculator">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="IPv4 subnet" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="SubnetInput" Tag="IPv4 or IPv6, e.g. 192.168.1.10/24 or 2001:db8::1/64" Width="260" Text="192.168.1.10/24" />
                                                <Button x:Name="BtnCalculateSubnet" Content="Calculate" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                                <TextBox x:Name="SplitPrefixInput" Tag="New prefix" Width="70" Margin="20,0,0,0" Text="26" />
                                                <Button x:Name="BtnSplitSubnet" Content="Split into" Margin="8,0,0,0" />
                                                <TextBox x:Name="HostCountInput" Tag="Hosts needed" Width="90" Margin="20,0,0,0" Text="300" />
                                                <Button x:Name="BtnPrefixForHosts" Content="Prefix for hosts" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                                       Text="Accepts IPv4 or IPv6, in CIDR notation or with a mask. The family is detected from the address. /31 point to point links and /32 host routes follow RFC 3021; IPv6 prefixes report their scope and interface identifier." />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <TextBox x:Name="SubnetOutput" Style="{StaticResource Mono}" Height="380"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 AcceptsReturn="True" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Adapters">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Button x:Name="BtnRefreshAdapters" Content="Refresh"
                                                    Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE72C;" />
                                            <Button x:Name="BtnPublicIp" Content="Show public address"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xEC27;"
                                                    ToolTip="Asks an external service what address the internet sees. The answer appears in the field on the right." />
                                            <Button x:Name="BtnListeningPorts" Content="Listening ports"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xE7F4;"
                                                    ToolTip="Opens the listening sockets in a window of their own, so this tab keeps its place." />
                                        </StackPanel>

                                        <!--
                                            The public address is shown here
                                            rather than only in the console.
                                            The console is collapsed by
                                            default, so an answer written
                                            only there is an answer nobody
                                            sees.
                                        -->
                                        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="{DynamicResource InputBackground}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                CornerRadius="5" Padding="12,7" Margin="16,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Public address" Style="{StaticResource FieldLabel}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox x:Name="PublicAddressValue"
                                                         Style="{StaticResource SelectableText}"
                                                         FontFamily="Cascadia Mono, Consolas"
                                                         FontSize="13" MinWidth="130"
                                                         Text="not queried yet" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="DocAdapters" IsReadOnly="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Diagnostics">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Reachability -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DiagLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Target" Style="{StaticResource FormLabel}" />
                                            <TextBox Grid.Column="1" x:Name="DiagTarget" Width="260"
                                                     Tag="Host, or a network in CIDR form for the sweep"
                                                     Text="192.168.1.1" />

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnTestConnectivity" Content="Connectivity chain"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Gateway, DNS and internet in order, so the first broken hop is the answer." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnPortScan" Content="Common ports"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Tries the usual service ports on that one host." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnSweep" Content="Sweep subnet"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Pings every address of the network written in CIDR form. Refuses anything wider than /22." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Name resolution -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DiagLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="DNS name" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="DnsName" Tag="Name to resolve" Width="260"
                                                         Text="www.microsoft.com" />
                                                <ComboBox x:Name="DnsType" Width="90" Margin="8,0,0,0"
                                                          ToolTip="Record type to ask for." />
                                                <TextBox x:Name="DnsServer" Tag="Server (optional)" Width="150" Margin="8,0,0,0"
                                                         ToolTip="Ask this resolver instead of the one the adapter is configured with. Useful for comparing an internal answer with a public one." />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <Button x:Name="BtnResolveDns" Content="Resolve"
                                                        Style="{StaticResource GroupedPrimaryButton}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                                   Text="Port checks and sweeps are for networks you administer. The sweep refuses any prefix shorter than /22 and every target is written to the log." />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="NetworkOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Admin tools">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Path behaviour -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AdminLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Host" Style="{StaticResource FormLabel}" />
                                            <TextBox Grid.Column="1" x:Name="AdminTarget" Width="260"
                                                     Tag="Host name or IP address" Text="8.8.8.8" />

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnPathMtu" Content="Path MTU"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Finds the largest packet that survives the path. Explains a link that connects but stalls on large transfers." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnLinkQuality" Content="Link quality"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Loss and jitter over a run of probes, which an average latency hides." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnTraceRoute" Content="Trace route"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Every hop between here and the host." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Transport security -->
                                        <Grid Grid.Row="1" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AdminLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="TLS" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="TlsHost" Tag="Host name" Width="260"
                                                         Text="www.microsoft.com" />
                                                <TextBox x:Name="TlsPort" Tag="Port" Width="80" Margin="8,0,0,0"
                                                         Text="443" ToolTip="Port to open the session on." />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <Button x:Name="BtnTlsCertificate" Content="Inspect certificate"
                                                        Style="{StaticResource GroupedPrimaryButton}"
                                                        ToolTip="Subject, issuer, validity and signature algorithm of the certificate that host presents." />
                                            </Border>
                                        </Grid>

                                        <!-- Layer two -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AdminLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Wake" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="WolMac" Tag="MAC 00:1A:2B:3C:4D:5E" Width="260" />
                                                <TextBox x:Name="WolBroadcast" Tag="Broadcast address" Width="160" Margin="8,0,0,0"
                                                         Text="255.255.255.255"
                                                         ToolTip="Wake-on-LAN needs the directed broadcast of the target subnet when the packet has to cross a router." />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnWakeOnLan" Content="Send magic packet"
                                                            Style="{StaticResource GroupedPrimaryButton}" />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnNeighbours" Content="Neighbour table"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="The local ARP and neighbour cache: which MAC answers for which address." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                                   Text="Hover any action for what it reports. Everything on this tab is read only except the magic packet, which only asks a machine to power on." />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="AdminOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Configuration">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Adapter IP profiles"
                                                   Style="{StaticResource SubHeading}" Margin="0,0,0,8" />

                                        <!-- Pick an adapter and a saved profile, then apply it. -->
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Adapter" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ComboBox x:Name="ProfileAdapter" Width="230"
                                                          ToolTip="The adapter a profile is applied to." />
                                                <ComboBox x:Name="ProfileSelect" Width="230" Margin="8,0,0,0"
                                                          ToolTip="A profile saved earlier." />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnApplyProfile" Content="Apply"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Writes the selected profile onto the selected adapter." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnDeleteProfile" Content="Delete"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Removes the saved profile. Does not change the adapter." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Compose a new profile. -->
                                        <Grid Grid.Row="2" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="New profile" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ProfileName" Width="180"
                                                         Tag="Name, e.g. Site Lyon VLAN 30" />
                                                <TextBox x:Name="ProfileAddress" Width="140" Margin="8,0,0,0"
                                                         Tag="Address" ToolTip="Address 192.168.50.10" />
                                                <TextBox x:Name="ProfilePrefix" Width="56" Margin="6,0,0,0"
                                                         Text="24" Tag="/" ToolTip="Prefix length" />
                                                <TextBox x:Name="ProfileGateway" Width="140" Margin="6,0,0,0"
                                                         Tag="Gateway" ToolTip="Gateway 192.168.50.1" />
                                                <TextBox x:Name="ProfileDns" Width="170" Margin="6,0,0,0"
                                                         Tag="DNS servers" ToolTip="Separated by commas: 1.1.1.1, 9.9.9.9" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnSaveProfile" Content="Save static"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Saves the fields on the left as a fixed address profile." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnSaveDhcpProfile" Content="Save DHCP"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Saves a profile that puts the adapter back on DHCP. Only the name is used." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnCaptureProfile" Content="Capture current"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Fills the fields from what the selected adapter is configured with right now." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Margin="0,0,0,4"
                                                   Text="Applying a profile to the adapter carrying your remote session will disconnect it." />

                                        <TextBlock Grid.Row="4" Text="Routes and port forwarding"
                                                   Style="{StaticResource SubHeading}" />

                                        <Grid Grid.Row="5" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Route" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="RoutePrefix" Width="180"
                                                         Tag="Destination" ToolTip="In CIDR form: 10.50.0.0/16" />
                                                <TextBox x:Name="RouteNextHop" Width="150" Margin="8,0,0,0"
                                                         Tag="Next hop" ToolTip="The router that reaches it: 192.168.1.254" />
                                                <ComboBox x:Name="RouteAdapter" Width="190" Margin="8,0,0,0"
                                                          ToolTip="The adapter the route leaves by." />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnAddRoute" Content="Add persistent"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Adds the route and keeps it across restarts." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnRemoveRoute" Content="Remove"
                                                            Style="{StaticResource GroupedButton}" />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnShowRoutes" Content="Show table"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="The whole routing table, in a window of its own." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Forward" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ProxyListenPort" Width="100"
                                                         Tag="Listen port" ToolTip="The port opened on this machine, e.g. 8080" />
                                                <TextBlock Text="to" Style="{StaticResource FormLabel}" Margin="10,0,10,0" />
                                                <TextBox x:Name="ProxyConnectAddress" Width="170"
                                                         Tag="Forward to" ToolTip="Destination address: 172.28.5.2" />
                                                <TextBox x:Name="ProxyConnectPort" Width="100" Margin="8,0,0,0"
                                                         Tag="Port" ToolTip="Destination port, e.g. 80" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnAddProxy" Content="Publish"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Opens the listening port and forwards it. Remember the firewall rule." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnRemoveProxy" Content="Remove"
                                                            Style="{StaticResource GroupedButton}" />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnShowProxies" Content="Show rules"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Every forwarding rule on this machine, in a window of its own." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="ConfigOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Knowledge base">
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0" x:Name="KnowledgeSearch" Tag="Search every topic" Margin="0,0,10,10" />
                                <ListBox Grid.Row="1" Grid.Column="0" x:Name="KnowledgeList" Margin="0,0,10,0"
                                         />

                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="KnowledgeContent" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 IsDocumentEnabled="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Vendor commands">
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                    <ComboBox x:Name="VendorSelect" Margin="0,0,0,8" />
                                    <TextBox  x:Name="VendorSearch" Tag="Search commands across all vendors" />
                                </StackPanel>

                                <ListBox Grid.Row="1" Grid.Column="0" x:Name="VendorSectionList" Margin="0,0,10,0"
                                         />

                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="VendorContent" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 IsDocumentEnabled="True" />
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>


                <!-- ======================= DIAGNOSTICS ======================= -->
                <Grid x:Name="PageDiagnostics" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                        <TextBlock Text="Diagnostics" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="What a support call actually needs answered, in the order it usually comes up. Everything here is read only: a tool that changes things while you are still looking destroys the evidence." />
                    </StackPanel>

                    <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" LastChildFill="True">
                        <Button x:Name="BtnDiagExport" DockPanel.Dock="Bottom"
                                Content="Export the last report" Margin="0,10,0,0"
                                HorizontalAlignment="Stretch" />
                        <ListBox x:Name="DiagnosticChoices" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000">
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Every check below, in order.">
                                <TextBlock Text="Full check" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="All six places Windows records one, including the invisible ones.">
                                <TextBlock Text="Pending reboot" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Reliability counters joined to free space, with SSD wear.">
                                <TextBlock Text="Storage health" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Bug checks, unexpected shutdowns and repeated application faults.">
                                <TextBlock Text="Crashes" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Through the update session, so driver and feature updates appear.">
                                <TextBlock Text="Update history" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Spooler, printers, ports, drivers and queue depth.">
                                <TextBlock Text="Printing" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Profile sizes, mapped drives, domain channel, logon timing.">
                                <TextBlock Text="Profiles and policy" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                        </ListBox>
                    </DockPanel>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                        <RichTextBox x:Name="DiagnosticsOutput" IsReadOnly="True"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextPrimary}"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     IsDocumentEnabled="True" />
                    </Border>
                </Grid>

                <!-- ======================== HARDWARE ======================== -->
                <!--
                    The checks a technician does with their hands. Everything
                    on the Diagnostics page reads the machine and reports;
                    these ask the operator to look, listen and press, which is
                    the only way to answer "is this key dead".
                -->
                <Grid x:Name="PageHardware" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Hardware" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Interactive checks on the parts a report cannot judge. Nothing here changes the machine." />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" x:Name="HardwareChoices" Margin="0,0,14,0"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000">
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Every key on the board, ticked off as you press it, while this window has focus.">
                                <TextBlock Text="Keyboard" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Full screen colours for dead and stuck pixels, a gradient for banding, and a grid for geometry.">
                                <TextBlock Text="Display" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="A tone in one channel at a time, which is the only way to catch a dead speaker.">
                                <TextBlock Text="Sound" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="What the pack holds now against what it was built to hold, and the Windows battery report.">
                                <TextBlock Text="Battery" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Memory slot by slot, and the panels attached to this machine.">
                                <TextBlock Text="Memory and displays" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                        </ListBox>

                        <!-- ============================ Keyboard ============================ -->
                        <Border Grid.Column="1" x:Name="PanelKeyboard" Style="{StaticResource Card}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="BtnKeyboardStart" Content="Start the test"
                                            Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE768;" />
                                    <Button x:Name="BtnKeyboardStop" Content="Stop"
                                            Style="{StaticResource GlyphButton}" Tag="&#xE711;" IsEnabled="False" />
                                    <Button x:Name="BtnKeyboardReset" Content="Clear"
                                            Style="{StaticResource GlyphButton}" Tag="&#xE72C;" />
                                    <TextBlock x:Name="KeyboardProgress" Style="{StaticResource FieldValue}"
                                               VerticalAlignment="Center" Margin="16,0,0,0"
                                               Text="Not started." />
                                </StackPanel>

                                <Border Grid.Row="1" Margin="0,0,0,10" CornerRadius="6" Padding="11,8"
                                        Background="{DynamicResource SurfaceRaised}"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <TextBlock x:Name="KeyboardHint" Style="{StaticResource Muted}"
                                               Text="Keep this window in front and press every key; each lights up as it registers. Press Escape twice to stop. The Windows key, Alt+Tab and Ctrl+Alt+Delete are claimed by Windows before any application sees them, so they will not light up: this test reads keys only while its own window is focused, which is why nothing mistakes it for a keylogger." />
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="KeyboardSurface" />
                                </ScrollViewer>

                                <TextBlock Grid.Row="3" x:Name="KeyboardResult" Style="{StaticResource Muted}"
                                           Margin="0,10,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- ============================ Display ============================= -->
                        <Border Grid.Column="1" x:Name="PanelDisplay" Style="{StaticResource Card}" Margin="0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Display" Style="{StaticResource SubHeading}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                                           Text="Each test fills the screen. Click or press any key to move to the next one, Escape to leave. Look at the panel from straight on and from an angle: a stuck pixel stays one colour on every screen, a reflection does not." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button x:Name="BtnDisplayColours" Content="Solid colours"
                                            Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE790;"
                                            ToolTip="White, black, red, green and blue in turn. A dead pixel shows black on white; a stuck one shows colour on black." />
                                    <Button x:Name="BtnDisplayGradient" Content="Gradient"
                                            Style="{StaticResource GlyphButton}" Tag="&#xE7A1;"
                                            ToolTip="Reveals banding and a panel that cannot render smooth tone." />
                                    <Button x:Name="BtnDisplayGrid" Content="Geometry grid"
                                            Style="{StaticResource GlyphButton}" Tag="&#xE80A;"
                                            ToolTip="A one pixel grid. Blurred or uneven lines mean the panel is not running at its native resolution." />
                                </StackPanel>

                                <TextBlock Text="Panels attached" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <RichTextBox x:Name="DocDisplays" IsReadOnly="True" MaxHeight="260"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled" />
                            </StackPanel>
                        </Border>

                        <!-- ============================= Sound ============================== -->
                        <Border Grid.Column="1" x:Name="PanelSound" Style="{StaticResource Card}" Margin="0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Sound" Style="{StaticResource SubHeading}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                                           Text="A tone in one channel at a time. Playing the same thing on both channels is how a dead speaker passes a test: if you hear the left tone and the right tone equally, both sides work." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="BtnToneLeft"  Content="Left channel"
                                            Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE7F6;" />
                                    <Button x:Name="BtnToneRight" Content="Right channel"
                                            Style="{StaticResource GlyphButton}" Tag="&#xE7F6;" />
                                    <Button x:Name="BtnToneBoth"  Content="Both"
                                            Style="{StaticResource GlyphButton}" Tag="&#xE995;" />
                                    <Button x:Name="BtnToneSweep" Content="Frequency sweep"
                                            Style="{StaticResource GlyphButton}" Tag="&#xE9D2;"
                                            ToolTip="Low to high. A rattle at one pitch is a loose driver or a case panel resonating." />
                                </StackPanel>

                                <TextBlock x:Name="SoundStatus" Style="{StaticResource Muted}" Margin="0,0,0,14"
                                           Text="Turn the volume to a comfortable level first." />

                                <TextBlock Text="Audio devices" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                <RichTextBox x:Name="DocAudio" IsReadOnly="True" MaxHeight="240"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled" />
                            </StackPanel>
                        </Border>

                        <!-- ============================ Battery ============================= -->
                        <Border Grid.Column="1" x:Name="PanelBattery" Style="{StaticResource Card}" Margin="0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Battery" Style="{StaticResource SubHeading}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                                           Text="Health is what the pack holds now against what it was built to hold. Below about eighty per cent a laptop starts feeling unreliable away from the mains, whatever the charge percentage says." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button x:Name="BtnBatteryRefresh" Content="Read the battery"
                                            Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE72C;" />
                                    <Button x:Name="BtnBatteryReport" Content="Full Windows report"
                                            Style="{StaticResource GlyphButton}" Tag="&#xE9F9;"
                                            ToolTip="Builds the powercfg battery report, which carries the charge cycles and the recent drain history, and opens it." />
                                </StackPanel>

                                <RichTextBox x:Name="DocBattery" IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled" />
                            </StackPanel>
                        </Border>

                        <!-- ======================== Memory and displays ===================== -->
                        <Border Grid.Column="1" x:Name="PanelMemory" Style="{StaticResource Card}" Margin="0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Memory" Style="{StaticResource SubHeading}" Margin="0,0,0,4" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                                           Text="Slot by slot. A machine reporting less memory than it has usually has one module seated badly, and one running slower than expected often has two modules of different speeds. A real memory test needs a restart: the Windows tool below runs before Windows loads, which is the only way to test memory that is not in use." />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Button x:Name="BtnMemoryRefresh" Content="Read the modules"
                                            Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE72C;" />
                                    <Button x:Name="BtnMemoryDiagnostic" Content="Schedule the Windows memory test"
                                            Style="{StaticResource GlyphButton}" Tag="&#xE950;"
                                            ToolTip="Opens the Windows Memory Diagnostic, which asks whether to restart now or at the next start up." />
                                </StackPanel>

                                <RichTextBox x:Name="DocMemory" IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ======================== SECURITY ======================== -->
                <Grid x:Name="PageSecurity" Margin="24,20" Visibility="Collapsed">
                    <TabControl x:Name="SecurityTabs" Background="Transparent" BorderThickness="0">

                        <TabItem Header="SSH keys">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Generate a key pair" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="SshKeyName" Tag="Key file name" Width="160" Text="id_ed25519" />
                                            <TextBlock Text="Type" VerticalAlignment="Center" Margin="16,0,8,0" />
                                            <ComboBox x:Name="SshKeyType" Width="110" />
                                            <TextBlock Text="Comment" VerticalAlignment="Center" Margin="16,0,8,0" />
                                            <TextBox x:Name="SshKeyComment" Tag="Comment identifying the key" Width="200" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Passphrase" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <PasswordBox x:Name="SshPassphrase" Width="220" />
                                            <CheckBox x:Name="SshNoPassphrase" Content="No passphrase (not recommended)" Margin="16,0,0,0" />
                                            <Button x:Name="BtnGenerateSshKey" Content="Generate" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" />
                                            <Button x:Name="BtnListSshKeys"    Content="List keys" />
                                            <Button x:Name="BtnCopyPublicKey"  Content="Copy public key" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                                   Text="ed25519 is the default. An existing key is never overwritten, and the private key permissions are restricted to the owner after generation." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="SshOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="File integrity">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="File" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="HashFilePath" Tag="Path to the file to hash" Width="440" />
                                            <Button x:Name="BtnBrowseHashFile" Content="Browse" Margin="10,0,0,0" />
                                            <Button x:Name="BtnComputeHash"    Content="Compute hashes" Style="{StaticResource PrimaryButton}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Expected hash" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="ExpectedHash" Tag="Paste the hash published by the vendor" Width="520" />
                                            <Button x:Name="BtnVerifyHash" Content="Verify" Margin="10,0,0,0" />
                                            <Button x:Name="BtnVirusTotal" Content="Check on VirusTotal" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                                   Text="The VirusTotal check sends the SHA256 only. The file itself is never uploaded, so internal documents and installers stay private." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="IntegrityOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Credentials">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="Length" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="PasswordLength" Tag="Length" Width="60" Text="20" />
                                            <CheckBox x:Name="PwdUpper"   Content="A-Z" IsChecked="True" Margin="14,0,0,0" />
                                            <CheckBox x:Name="PwdLower"   Content="a-z" IsChecked="True" Margin="10,0,0,0" />
                                            <CheckBox x:Name="PwdDigits"  Content="0-9" IsChecked="True" Margin="10,0,0,0" />
                                            <CheckBox x:Name="PwdSymbols" Content="Symbols" IsChecked="True" Margin="10,0,0,0" />
                                            <Button x:Name="BtnGeneratePassword"   Content="Generate password" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" />
                                            <Button x:Name="BtnGeneratePassphrase" Content="Generate passphrase" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Check a password" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <PasswordBox x:Name="BreachPassword" Width="260" />
                                            <Button x:Name="BtnCheckBreach" Content="Check against breaches" Margin="10,0,0,0" />
                                            <Button x:Name="BtnCopyPassword" Content="Copy last generated" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                                   Text="The breach check uses k-anonymity: only the first five characters of the SHA1 hash are sent, so the password never leaves this machine." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="CredentialOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Local audit">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="BtnRunAudit"    Content="Run the audit" Style="{StaticResource PrimaryButton}" />
                                    <Button x:Name="BtnExportAudit" Content="Export report" />
                                    <TextBlock x:Name="AuditSummary" VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource Muted}" />
                                </StackPanel>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="AuditOutput" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 IsDocumentEnabled="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Hardening">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="BtnHardening"       Content="Run the hardening check" Style="{StaticResource PrimaryButton}" />
                                            <Button x:Name="BtnExportHardening" Content="Export report" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                                   Text="The controls that decide whether an intrusion stays on one machine or reaches the whole estate: credential protection, endpoint rules, logging, SMB and NTLM, and recovery. Separate from the audit because it is a different question: not whether the basics are on, but whether credential theft and lateral movement are actually made difficult." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="HardeningOutput" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 IsDocumentEnabled="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Threat hunting">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="270" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Muted}" Margin="0,0,0,12"
                                           Text="Four read only investigations. Nothing here changes the machine, which is what makes them safe to run first on a system whose state you do not want to disturb. Event triage needs an elevated instance, because the Security log is not readable otherwise." />

                                <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <TextBlock Text="Endpoints to check" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="CertEndpoints" Margin="0,0,0,6"
                                                 Tag="intranet, dc01:636, vpn.example.com" />
                                        <Button x:Name="BtnCheckEndpointCerts" Content="Check certificate expiry"
                                                HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                        <Button x:Name="BtnExportHunt" Content="Export the last report"
                                                HorizontalAlignment="Stretch" Margin="0" />
                                    </StackPanel>

                                    <ListBox x:Name="HuntChoices" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000">
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Failed logons, lockouts, services installed, logs cleared.">
                                            <TextBlock Text="Event log triage" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Run keys, services, tasks and WMI subscriptions, signature checked.">
                                            <TextBlock Text="Autostart and persistence" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Listening sockets joined to the inbound firewall policy.">
                                            <TextBlock Text="Network exposure" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Machine and user stores: expiry, SHA-1, weak keys.">
                                            <TextBlock Text="Certificate inventory" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                    </ListBox>
                                </DockPanel>

                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="HuntOutput" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 IsDocumentEnabled="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Settings">
                            <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="VirusTotal API key" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                                                       Text="Stored encrypted with DPAPI under this Windows account. It cannot be decrypted by another user or on another machine, and it never appears in a log or a command line. A free account gives 4 requests per minute." />
                                            <StackPanel Orientation="Horizontal">
                                                <PasswordBox x:Name="VtApiKey" Width="360" />
                                                <Button x:Name="BtnSaveVtKey"   Content="Save key" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                                <Button x:Name="BtnRemoveVtKey" Content="Remove stored key" />
                                            </StackPanel>
                                            <TextBlock x:Name="VtKeyStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Data and logs" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                            <TextBlock x:Name="DataPathText" Style="{StaticResource Muted}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button x:Name="BtnOpenDataFolder" Content="Open data folder" />
                                                <Button x:Name="BtnClearLogs"      Content="Delete old logs" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================= Console ============================= -->
        <Expander Grid.Row="2" x:Name="ConsoleExpander" IsExpanded="False"
                  Background="{DynamicResource Surface}" Foreground="{DynamicResource TextMuted}"
                  BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,6">
            <Expander.Header>
                <TextBlock Text="Output" FontSize="12" Foreground="{DynamicResource TextMuted}" />
            </Expander.Header>
            <TextBox x:Name="OutputConsole" Height="150" Style="{StaticResource Mono}"
                     Margin="0,6,0,6" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" />
        </Expander>

        <!-- =========================== Status bar =========================== -->
        <Border Grid.Row="3" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="Ready." Style="{StaticResource Muted}" />
                <ProgressBar Grid.Column="1" x:Name="BusyBar" Width="180" Height="6"
                             IsIndeterminate="True" Visibility="Hidden"
                             Background="{DynamicResource SurfaceRaised}" Foreground="{DynamicResource Accent}" />
            </Grid>
        </Border>
    </Grid>
</Window>
