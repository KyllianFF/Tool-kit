                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   Text="dsacls sets the permissions on an Active Directory object such as an OU, the same delegation the Delegation of Control wizard writes. Run it elevated on a domain-joined machine with the AD tools. Test on a lab OU first: a wrong deny or a broad grant is easy to make and awkward to unpick." />
                                    </StackPanel>
