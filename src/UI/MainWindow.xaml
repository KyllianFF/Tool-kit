                                                     FontFamily="Cascadia Mono, Consolas, Courier New" Tag="1000, 1001" />
                                            <TextBlock Text="Level" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <ComboBox x:Name="EventQueryLevel" Width="130" MinHeight="40" Margin="0,0,16,8" />
                                            <TextBlock Text="Last (hours)" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="EventQueryHours" Width="70" Margin="0,0,16,8" Text="24"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" />
                                            <TextBlock Text="Max" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="EventQueryMax" Width="70" Margin="0,0,0,8" Text="50"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="Provider" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="EventQueryProvider" Width="240" Margin="0,0,16,0"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" Tag="optional, e.g. Application Error" />
                                            <TextBlock Text="Text contains" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="EventQueryContains" Width="200"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" Tag="optional" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="The text search is only in the XPath forms, since a FilterHashtable cannot express it. Levels: Critical, Error, Warning, Information, Verbose." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="EventQueryOutput" Style="{StaticResource Mono}" IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                </Border>
                            </Grid>

                            <Grid x:Name="ToolHtmlEditor" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="HTML editor" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,4">
                                            <Button x:Name="BtnEditorBold"      Content="Bold" FontWeight="Bold" Margin="0,0,6,8" />
                                            <Button x:Name="BtnEditorItalic"    Content="Italic" FontStyle="Italic" Margin="0,0,6,8" />
                                            <Button x:Name="BtnEditorUnderline" Content="Underline" Margin="0,0,16,8" />
                                            <Button x:Name="BtnEditorHeading1"  Content="Heading 1" Margin="0,0,6,8" />
                                            <Button x:Name="BtnEditorHeading2"  Content="Heading 2" Margin="0,0,6,8" />
                                            <Button x:Name="BtnEditorBody"      Content="Body text" Margin="0,0,16,8" />
                                            <Button x:Name="BtnEditorBullets"   Content="Bullets" Margin="0,0,6,8" />
                                            <Button x:Name="BtnEditorNumbering" Content="Numbering" Margin="0,0,16,8" />
                                            <Button x:Name="BtnEditorClear"     Content="Clear formatting" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBox x:Name="EditorLinkUrl" Width="320" Margin="0,0,8,8"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" Tag="https://... for the selected text" />
                                            <Button x:Name="BtnEditorLink" Content="Make a link" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="Write on the left with the buttons or Ctrl+B, Ctrl+I and Ctrl+U, and the HTML follows on the right: headings, paragraphs, lists, bold, italic, underline and links, nothing else, so it pastes cleanly into a signature, a ticket or a wiki. HTML pasted on the right loads into the editor without its scripts, styles and attributes." />
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                                        <RichTextBox x:Name="HtmlEditor" AcceptsTab="True" IsDocumentEnabled="True"
                                                     BorderThickness="0" Background="Transparent"
                                                     Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                                                     VerticalScrollBarVisibility="Auto" />
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBox Grid.Row="0" x:Name="HtmlSource" Style="{StaticResource Mono}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Disabled" />
                                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                                <Button x:Name="BtnHtmlCopy" Content="Copy HTML" Margin="0,0,8,0" />
                                                <Button x:Name="BtnHtmlLoad" Content="Load into the editor" />
                                            </WrapPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid x:Name="ToolQrCode" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="QR code" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <TextBox x:Name="QrInput" Height="80" Margin="0,0,0,8"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                 FontFamily="Cascadia Mono, Consolas, Courier New" Tag="A link or a text to encode" />
                                        <WrapPanel>
                                            <TextBlock Text="Error correction" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <ComboBox x:Name="QrErrorCorrection" Width="240" MinHeight="40" Margin="0,0,16,8" />
                                            <Button x:Name="BtnSaveQr" Content="Save as PNG" Margin="0,0,8,8" />
                                            <Button x:Name="BtnCopyQr" Content="Copy the picture" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="Drawn on this machine as you type, nothing is sent. More error correction survives a scratched or partly covered code but makes it denser: 15% suits a screen or a sticker, 30% a printed sheet that will be handled." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!--
                                            Scaled down, never cropped, when the window is short: a code
                                            missing a corner of its finder patterns does not scan.
                                        -->
                                        <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <Border Background="White" Width="300" Height="300">
                                                <Image x:Name="QrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" x:Name="QrInfo" Margin="16,0,0,0" TextWrapping="Wrap"
                                                   FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="ToolWifiQr" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Wi-Fi QR code" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,4">
                                            <TextBlock Text="Network name" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="WifiQrSsid" Width="240" Margin="0,0,16,8" Tag="The SSID" />
                                            <TextBlock Text="Security" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <ComboBox x:Name="WifiQrSecurity" Width="220" MinHeight="40" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="Password" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <PasswordBox x:Name="WifiQrPassword" Width="240" Margin="0,0,16,8" />
                                            <CheckBox x:Name="WifiQrHidden" Content="Hidden network" VerticalAlignment="Center" Margin="0,0,16,8" />
                                            <Button x:Name="BtnWifiQrCurrent" Content="Use the connected network" Margin="0,0,8,8" />
                                            <Button x:Name="BtnSaveWifiQr" Content="Save as PNG" Margin="0,0,8,8" />
                                            <Button x:Name="BtnCopyWifiQr" Content="Copy the picture" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="A phone camera that scans it joins the network without typing the password: print it for guests or a meeting room. Anyone who sees the code can join, so treat it as the password itself. It is drawn on this machine and nothing is sent." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" HorizontalAlignment="Left">
                                            <Border Background="White" Width="300" Height="300">
                                                <Image x:Name="WifiQrImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            </Border>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" x:Name="WifiQrInfo" Margin="16,0,0,0" TextWrapping="Wrap"
                                                   FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5" />
                                    </Grid>
                                </Border>
                            </Grid>

                        </Grid>
                    </Grid>
                </Grid>

                <!-- ======================= KNOWLEDGE ======================== -->
                <Grid x:Name="PageKnowledge" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Knowledge base" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Network and Windows topics looked up during a support call, and what a Windows error code or event ID means: its cause and what to try." />
                    </StackPanel>

                    <TabControl Grid.Row="1" x:Name="KnowledgeTabs">

                        <TabItem Header="Topics">
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0" x:Name="KnowledgeSearch" Tag="Search every topic" Margin="0,0,10,10" />
                                <ListBox Grid.Row="1" Grid.Column="0" x:Name="KnowledgeList" Margin="0,0,10,0"
                                         />

                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="KnowledgeContent" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 IsDocumentEnabled="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Windows codes">
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Grid.Column="0" x:Name="ReferenceSearch" Margin="0,0,10,10"
                                         Tag="Error code, event ID or words" />
                                <ListBox Grid.Row="1" Grid.Column="0" x:Name="ReferenceList" Margin="0,0,10,0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="ReferenceContent" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 IsDocumentEnabled="True" />
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ==================== VENDOR COMMANDS ===================== -->
                <Grid x:Name="PageVendorCommands" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Commands" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Cheat sheets for Git, PowerShell, Bash, Linux, Active Directory, the Windows command line, Intune, Microsoft Graph and Exchange Online, OpenSSL, packet capture, Docker, Kubernetes and hypervisors, then the commands of network equipment by manufacturer. Pick one, or search all of them at once." />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                            <ComboBox x:Name="VendorSelect" MinHeight="40" Margin="0,0,0,8" />
                            <TextBox  x:Name="VendorSearch" Tag="Search every cheat sheet and platform" />
                        </StackPanel>

                        <ListBox Grid.Row="1" Grid.Column="0" x:Name="VendorSectionList" Margin="0,0,10,0"
                                 />

                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                            <RichTextBox x:Name="VendorContent" IsReadOnly="True"
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource TextPrimary}"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         IsDocumentEnabled="True" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- ====================== INTERVENTION ====================== -->
                <!--
                    The journal of what was done on this machine, and the report of
                    the visit. The journal fills itself as operations run; the
                    technician adds the ticket and the notes.
                -->
                <!-- ========================= PLAYBOOKS ========================= -->
                <Grid x:Name="PagePlaybooks" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Playbooks" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Guided sequences for the problems a support call is about. A playbook puts the reports, checks and fixes the toolkit already has into the order to work through them. Each step takes you where it happens; come back here for the next one." />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" x:Name="PlaybookChoices" Background="Transparent" BorderThickness="0" Margin="0,0,16,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000">
                            <ListBoxItem Style="{StaticResource ReportChoice}" ToolTip="Everything takes too long: applications, start-up, or the whole desktop.">
                                <TextBlock Text="The machine is slow" Style="{StaticResource ChoiceTitle}" TextWrapping="Wrap" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}" ToolTip="No connectivity, an intermittent connection, or a site that will not load.">
                                <TextBlock Text="No internet or a network problem" Style="{StaticResource ChoiceTitle}" TextWrapping="Wrap" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}" ToolTip="A sign-in that is refused, a single sign-on that keeps prompting, or a device that lost its trust.">
                                <TextBlock Text="Cannot sign in to the domain or Microsoft 365" Style="{StaticResource ChoiceTitle}" TextWrapping="Wrap" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}" ToolTip="Low disk space warnings, or a drive with no room left.">
                                <TextBlock Text="The disk is full" Style="{StaticResource ChoiceTitle}" TextWrapping="Wrap" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}" ToolTip="Odd behaviour, a security alert, or a machine you have reason to distrust.">
                                <TextBlock Text="Suspected malware or compromise" Style="{StaticResource ChoiceTitle}" TextWrapping="Wrap" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}" ToolTip="The machine restarts on its own, freezes, or shows a stop error.">
                                <TextBlock Text="Blue screens or crashes" Style="{StaticResource ChoiceTitle}" TextWrapping="Wrap" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}" ToolTip="Nothing prints, the queue is stuck, or a printer has vanished.">
                                <TextBlock Text="Printing does not work" Style="{StaticResource ChoiceTitle}" TextWrapping="Wrap" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}" ToolTip="An update that will not install, keeps failing, or hangs.">
                                <TextBlock Text="Windows Update is stuck or failing" Style="{StaticResource ChoiceTitle}" TextWrapping="Wrap" />
                            </ListBoxItem>
                        </ListBox>

                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PlaybookSteps" Margin="4" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="PageIntervention" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Intervention" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="What was done on this machine, written down as it happens, and the report of the visit. Every fix, tweak, installation, audit correction, audit and report run through the toolkit appears in the journal." />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ticket" Style="{StaticResource FormLabel}" />
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="InterventionTicket" Margin="0,0,16,0"
                                       Tag="Ticket or case reference" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Technician" Style="{StaticResource FormLabel}" />
                            <TextBox   Grid.Row="0" Grid.Column="3" x:Name="InterventionTechnician" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Notes" Style="{StaticResource FormLabel}"
                                       VerticalAlignment="Top" Margin="0,18,12,0" />
                            <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="InterventionNotes" Margin="0,10,0,0"
                                       Height="96" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                       VerticalContentAlignment="Top"
                                       Tag="What was reported, what was found, what was done by hand, what is left to do" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--
                                The actions wrap under the period rather than off the edge: four
                                buttons beside the period no longer fit a window narrower than
                                about 1300 pixels.
                            -->
                            <Grid Grid.Row="0" Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,3,16,3">
                                    <TextBlock Text="Journal" Style="{StaticResource SubHeading}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="JournalPeriod" Width="150" Margin="16,0,0,0" />
                                    <Button x:Name="BtnJournalRefresh" Content="Refresh" Style="{StaticResource GlyphButton}"
                                            Tag="&#xE72C;" Margin="8,0,0,0" />
                                </StackPanel>

                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Button x:Name="BtnTakeSnapshot" Content="Snapshot" Margin="8,3,0,3"
                                            Style="{StaticResource GlyphButton}" Tag="&#xE722;"
                                            ToolTip="Saves the state of the machine now, to compare with at the end of the visit. It takes about half a minute and changes nothing." />
                                    <Button x:Name="BtnCompareSnapshot" Content="Compare" Margin="8,3,0,3"
                                            Style="{StaticResource GlyphButton}" Tag="&#xE8F1;"
                                            ToolTip="Collects the same reports again and shows what changed since a snapshot: judgements that got worse or better, devices and findings that appeared or went, new crashes and updates, and facts such as the Windows build, the BIOS version or the audit score." />
                                    <Button x:Name="BtnJournalFolder" Content="Open journal folder" Margin="8,3,0,3" />
                                    <Button x:Name="BtnInterventionReport" Content="Create the intervention report"
                                            Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE8A5;" Margin="8,3,0,3"
                                            ToolTip="One HTML file with the machine, its health, the latest audit, what was done and the notes, to attach to the ticket." />
                                </WrapPanel>
                            </Grid>

                            <RichTextBox Grid.Row="1" x:Name="JournalOutput" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                         IsDocumentEnabled="True" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ======================== SETTINGS ======================== -->
                <!--
                    What the toolkit keeps for this Windows account. It lived in a tab
                    of the Security page, where nobody looked for a data folder.
                -->
                <Grid x:Name="PageSettings" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Settings" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Kept for this Windows account only: the VirusTotal key, and the folder where the toolkit writes its data and logs." />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="VirusTotal API key" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                                               Text="Stored encrypted with DPAPI under this Windows account. It cannot be decrypted by another user or on another machine, and it never appears in a log or a command line. A free account gives 4 requests per minute." />
                                    <StackPanel Orientation="Horizontal">
                                        <PasswordBox x:Name="VtApiKey" Width="360" />
                                        <Button x:Name="BtnSaveVtKey"   Content="Save key" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                        <Button x:Name="BtnRemoveVtKey" Content="Remove stored key" />
                                    </StackPanel>
                                    <TextBlock x:Name="VtKeyStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Data and logs" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                    <TextBlock x:Name="DataPathText" Style="{StaticResource Muted}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="BtnOpenDataFolder" Content="Open data folder" />
                                        <Button x:Name="BtnClearLogs"      Content="Delete old logs" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================= Console ============================= -->
        <Expander Grid.Row="2" x:Name="ConsoleExpander" IsExpanded="False"
                  Background="{DynamicResource Surface}" Foreground="{DynamicResource TextMuted}"
                  BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,6">
            <Expander.Header>
                <TextBlock Text="Output" FontSize="12" Foreground="{DynamicResource TextMuted}" />
            </Expander.Header>
            <TextBox x:Name="OutputConsole" Height="150" Style="{StaticResource Mono}"
                     Margin="0,6,0,6" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" />
        </Expander>

        <!-- =========================== Status bar =========================== -->
        <Border Grid.Row="3" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="Ready." Style="{StaticResource Muted}" />
                <ProgressBar Grid.Column="1" x:Name="BusyBar" Width="180" Height="6"
                             IsIndeterminate="True" Visibility="Hidden"
                             Background="{DynamicResource SurfaceRaised}" Foreground="{DynamicResource Accent}" />
            </Grid>
        </Border>

        <!-- ========================== Search palette ========================== -->
        <!--
            Over the whole window, opened with Ctrl+K or the header button. The
            backdrop is a translucent black rather than a palette colour on
            purpose: it dims whatever theme is under it by the same amount, and
            clicking it closes the palette.
        -->
        <Grid Grid.Row="0" Grid.RowSpan="4" x:Name="SearchOverlay" Visibility="Collapsed">
            <Border x:Name="SearchBackdrop" Background="#99000000" />
            <Border Style="{StaticResource Card}" Width="680" Margin="0,64,0,0" Padding="12"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
                <StackPanel>
                    <TextBox x:Name="SearchInput" FontSize="15"
                             Tag="Search pages, reports, fixes, tweaks, applications, topics and commands" />
                    <TextBlock x:Name="SearchHint" Style="{StaticResource Muted}" Margin="4,8,4,6" />
                    <ListBox x:Name="SearchResults" MaxHeight="440" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
