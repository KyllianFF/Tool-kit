<!--
    Toolkit - Main window

    Loaded at run time with XamlReader, which imposes two rules on this file:

      - no x:Class attribute, because there is no compiled code behind;
      - no event handler attributes, because XamlReader cannot resolve them.
        Every handler is attached from PowerShell through FindName.

    Layout: a fixed header, a navigation rail, one panel per feature area of
    which exactly one is visible, a collapsible output console and a status
    bar. Colours are declared once as resources so a light theme is a
    resource swap rather than a rewrite.
-->
<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Toolkit"
    Height="820" Width="1320"
    MinHeight="640" MinWidth="1080"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource AppBackground}">

    <Window.Resources>

        <!--
            Palette.

            Declared once here as the dark values and swapped at run time by
            Set-TkTheme, which replaces the brush objects behind these keys.
            Every control below refers to them with DynamicResource, never
            with a literal colour, so a theme change repaints the whole
            window without rebuilding it.

            Never hard code a colour on a control. The previous version did
            that for the combo boxes and list views, which left black text on
            a dark background in half the interface.
        -->
        <SolidColorBrush x:Key="AppBackground"   Color="#16181D" />
        <SolidColorBrush x:Key="Surface"         Color="#1E2128" />
        <SolidColorBrush x:Key="SurfaceRaised"   Color="#262A33" />
        <SolidColorBrush x:Key="InputBackground" Color="#12141A" />
        <SolidColorBrush x:Key="BorderSubtle"    Color="#333845" />
        <SolidColorBrush x:Key="TextPrimary"     Color="#E7EAF0" />
        <SolidColorBrush x:Key="TextMuted"       Color="#98A1B2" />
        <SolidColorBrush x:Key="Accent"          Color="#4C8DFF" />
        <SolidColorBrush x:Key="AccentMuted"     Color="#2A4C8A" />
        <SolidColorBrush x:Key="Selection"       Color="#2F3A4F" />
        <SolidColorBrush x:Key="RowAlternate"    Color="#252932" />
        <SolidColorBrush x:Key="Success"         Color="#3FB950" />
        <SolidColorBrush x:Key="Warning"         Color="#D29922" />
        <SolidColorBrush x:Key="Danger"          Color="#F85149" />

        <!-- ============================ Icons ============================
            Segoe Fluent Icons ships with Windows 11 and Segoe MDL2 Assets
            with Windows 10, so the glyphs cost nothing to distribute: no
            image files, no download, and they take the foreground colour of
            whatever draws them, which means they follow a theme change for
            free. The fallback order covers both releases.

            Every code point below was chosen by rendering the font inventory
            and looking at it. Guessing one produces an empty box.
        -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
            <Setter Property="FontSize"   Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment"   Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment"       Value="Center" />
        </Style>

        <!-- The glyph that leads a button label. -->
        <Style x:Key="ButtonGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin"   Value="0,0,7,0" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- ============================ Text ============================ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize"   Value="13" />
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin"     Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="SubHeading" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin"     Value="0,14,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize"     Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--
            Styles for use inside a DataTemplate.

            An implicit style does not reach into a DataTemplate: a TextBlock
            declared there with no Style of its own falls back to the system
            default and renders black, which is unreadable on the dark theme.
            That is exactly what happened to the item titles on the Software,
            Tweaks and Fixes lists. Every element inside a template therefore
            names its style explicitly.
        -->
        <Style x:Key="ItemTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ItemText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}" />

        <Style x:Key="ItemBadge" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize"   Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <Style x:Key="ItemState" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize"   Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Success}" />
        </Style>

        <Style x:Key="ItemCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}" />

        <Style x:Key="ItemButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />

        <!--
            The coloured square that opens a list row.

            Its fill is an identity colour set from the page code, deliberately
            outside the palette: it has to mean the same thing in both themes.
            Each one is dark enough to carry a white glyph, which is why the
            glyph colour is literal here and nowhere else.
        -->
        <Style x:Key="ItemTile" TargetType="Border">
            <Setter Property="Width"        Value="34" />
            <Setter Property="Height"       Value="34" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"       Value="0,0,11,0" />
        </Style>

        <Style x:Key="TileGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="FontSize"   Value="16" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!--
            A selectable card. The border and a tinted fill carry the selected
            state, with a tick on the right, so the whole row reads as chosen
            rather than a small box in the corner being ticked.
        -->
        <Style x:Key="AppCard" TargetType="ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor"    Value="Hand" />
            <Setter Property="Margin"    Value="4,3" />
            <Setter Property="Padding"   Value="10,7" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" CornerRadius="8"
                                Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextMuted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"     Value="{DynamicResource Accent}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Chrome" Property="Background"      Value="{DynamicResource Selection}" />
                                <Setter TargetName="Chrome" Property="Padding"         Value="9,6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A card that is itself the action.

            The same shape as AppCard, but a Button rather than a ToggleButton
            because a fix is run, not selected. It replaces a small Run button
            at the end of the row: the row was already the thing you were
            reading and pointing at, so making the row the target removes a
            second, smaller one. The chevron on the right says so, and the
            border lighting up under the pointer confirms it.

            Disabled state matters here. A fix that needs rights this instance
            does not have is greyed whole, with the reason in its tooltip,
            rather than accepting the click and refusing afterwards.
        -->
        <Style x:Key="ActionCard" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor"     Value="Hand" />
            <Setter Property="Margin"     Value="4,3" />
            <Setter Property="Padding"    Value="12,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="8"
                                Background="{DynamicResource SurfaceRaised}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Chrome" Property="Background"  Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentMuted}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A report chooser entry. Eight buttons in a row is a toolbar, and a
            toolbar is the wrong shape for "pick one of these to run": nothing
            says which is selected, and there is no room for the one line that
            explains what each one does. A list has both.
        -->
        <Style x:Key="ReportChoice" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin"  Value="0,0,0,3" />
            <Setter Property="Cursor"  Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" CornerRadius="6"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1,1,1,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaised}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background"  Value="{DynamicResource Selection}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize"   Value="13" />
        </Style>

        <Style x:Key="ChoiceHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground"   Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize"     Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin"       Value="0,2,0,0" />
        </Style>

        <!--
            A category heading inside a chooser list. Disabled and not
            focusable, so a click, the arrow keys and the search index all
            pass over it to the entries.
        -->
        <Style x:Key="ChoiceGroup" TargetType="ListBoxItem">
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin"    Value="0,12,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Margin="12,0,0,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChoiceGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Margin"     Value="0,0,0,2" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize"     Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin"       Value="0,0,0,12" />
        </Style>

        <!-- =========================== Buttons =========================== -->
        <Style TargetType="Button">
            <!--
                A tooltip on a disabled control is hidden by default, which
                defeats the one case it is most needed for: a greyed action
                whose tooltip is the explanation of why it is greyed. Set
                here so every button in the application inherits it, styles
                based on this one included.
            -->
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Background"      Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="14,7" />
            <Setter Property="Margin"          Value="0,0,8,0" />
            <Setter Property="FontFamily"      Value="Segoe UI" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="Cursor"          Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"  Value="{DynamicResource AccentMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight"  Value="SemiBold" />
        </Style>

        <!--
            A button that leads with an icon.

            The glyph comes from Tag rather than from a nested TextBlock in
            the content, because a TextBlock declared in content picks up the
            implicit style and its explicit Foreground, which overrides the
            inherited one and leaves a label in the wrong colour on the accent
            fill. Read from the template, it takes the button's own
            foreground and stays correct in both themes and when disabled.

            Only for buttons whose Tag is free. The ones that carry an
            identifier in Tag, such as the fix runners, keep the plain style.
        -->
        <!--
            An icon sitting beside the value it acts on: copy next to a serial
            number, a link next to a manufacturer. Small and borderless, so the
            value stays the thing that is read, and the action is found where the
            eye already is rather than in a row of buttons at the top of the page.
        -->
        <Style x:Key="InlineGlyphButton" TargetType="Button">
            <Setter Property="Width"      Value="26" />
            <Setter Property="Height"     Value="26" />
            <Setter Property="Cursor"     Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="4">
                            <TextBlock Text="{TemplateBinding Tag}"
                                       FontFamily="{DynamicResource IconFont}" FontSize="13"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlyphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="14"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlyphPrimaryButton" TargetType="Button" BasedOn="{StaticResource GlyphButton}">
            <Setter Property="Background"  Value="{DynamicResource AccentMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight"  Value="SemiBold" />
        </Style>

        <!--
            Actions that all operate on the field beside them.

            A loose row of buttons after a text box says nothing about which
            of them uses it, and the network tabs had three or four per row
            with no visual tie to their input at all. Enclosing them in one
            container makes the relationship structural: this box holds the
            things you can do to that field. A divider between them keeps
            them readable as separate actions rather than one long strip.
        -->
        <Style x:Key="ActionGroup" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="6" />
            <Setter Property="Padding"         Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment"   Value="Center" />
            <Setter Property="Margin"          Value="12,0,0,0" />
        </Style>

        <Style x:Key="GroupedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin"          Value="0" />
            <Setter Property="Padding"         Value="13,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentMuted}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The action a group runs if you only press one thing. -->
        <Style x:Key="GroupedPrimaryButton" TargetType="Button" BasedOn="{StaticResource GroupedButton}">
            <Setter Property="Background" Value="{DynamicResource AccentMuted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="GroupDivider" TargetType="Rectangle">
            <Setter Property="Width"  Value="1" />
            <Setter Property="Fill"   Value="{DynamicResource BorderSubtle}" />
            <Setter Property="Margin" Value="2,7" />
        </Style>

        <!-- The label in front of a form field. Kept to one width per tab
             with SharedSizeGroup, so the fields line up down the card. -->
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground"        Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize"          Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin"            Value="0,0,12,0" />
        </Style>

        <!--
            A heading between groups of navigation entries. Small and muted, so
            the entries stay what the eye lands on and the heading only says
            which kind of work they belong to.
        -->
        <Style x:Key="NavSection" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin"     Value="24,10,16,2" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"          Value="Transparent" />
            <Setter Property="BorderThickness"     Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding"             Value="16,8" />
            <Setter Property="Margin"              Value="8,1,8,1" />
            <Setter Property="FontSize"            Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="{DynamicResource IconFont}"
                                           FontSize="16"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           Width="24" />
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================== Text entry ========================== -->
        <!--
            The default text box carries a hint: whatever is in its Tag is
            shown, greyed, while the box is empty. A field that does not say
            what belongs in it is a field nobody fills in correctly, and the
            configuration tab has a row of them.
        -->
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="8,6" />
            <Setter Property="FontFamily"      Value="Segoe UI" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush"  Value="{DynamicResource Accent}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Grid>
                                <!--
                                    The hint takes its inset from Padding, the
                                    same source the content host uses below. As
                                    two independent values, a literal here and a
                                    template binding there, they drifted: the
                                    placeholder sat one pixel off from where the
                                    caret appears, and any control that set its
                                    own Padding moved the caret without moving
                                    the placeholder.
                                -->
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           FontSize="{TemplateBinding FontSize}"
                                           IsHitTestVisible="False" Visibility="Collapsed"
                                           TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Text that can be selected and copied but looks like a label.

            A TextBlock cannot be selected on .NET Framework, and a table
            nobody can copy a thumbprint or a path out of is half a table. A
            read only TextBox behaves correctly, but the implicit style above
            would give it a border, a fill and a hint, so it needs a template
            of its own.

            The template must contain a ScrollViewer named PART_ContentHost:
            that is where TextBoxBase renders the text. Clearing the template
            instead leaves the control with no visual tree at all, which is
            not an invisible border but an invisible control. Every table and
            every finding card rendered blank until this replaced it.
        -->
        <Style x:Key="SelectableText" TargetType="TextBox">
            <Setter Property="IsReadOnly"      Value="True" />
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="FontFamily"      Value="Segoe UI" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="TextWrapping"    Value="Wrap" />
            <Setter Property="IsTabStop"       Value="False" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush"  Value="{DynamicResource Accent}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility"   Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background"      Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="8,6" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="CaretBrush"      Value="{DynamicResource TextPrimary}" />
        </Style>

        <!--
            Output boxes reuse the same template. It respects the control's
            alignment and scroll bar settings, so the one line fields stay
            centred and the reports scroll.
        -->
        <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="FontFamily"     Value="Cascadia Mono, Consolas, Courier New" />
            <Setter Property="FontSize"       Value="12" />
            <Setter Property="IsReadOnly"     Value="True" />
            <Setter Property="Background"     Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground"     Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"    Value="{DynamicResource BorderSubtle}" />
            <Setter Property="CaretBrush"     Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="TextWrapping"   Value="NoWrap" />
        </Style>

        <!-- ========================== CheckBox ========================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                <Path x:Name="Tick" Stretch="Uniform" Margin="3"
                                      Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                                      Visibility="Collapsed"
                                      Data="M 0 4 L 3 7 L 8 1" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box"  Property="Background"  Value="{DynamicResource AccentMuted}" />
                                <Setter TargetName="Box"  Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility"  Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================== ComboBox ==========================
             A full template is required. The stock one paints its own popup
             and toggle chrome from system colours, so setting Background and
             Foreground alone leaves a white drop-down with black text in the
             middle of a dark window.
        -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding"    Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{DynamicResource InputBackground}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding"         Value="8,6" />
            <Setter Property="FontSize"        Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" CornerRadius="5"
                                                Background="{DynamicResource InputBackground}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource TextMuted}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="10,0,26,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{DynamicResource TextPrimary}" />

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320" CornerRadius="5"
                                        Background="{DynamicResource Surface}"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ====================== Lists and grids ======================= -->
        <Style TargetType="ListBox">
            <Setter Property="Background"      Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding"    Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Selection}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The list view styles that used to live here are gone with the last
            GridView. Every table in the application is now built by
            Add-TkTable, which gives selectable cells, banded rows, draggable
            column edges and live theme following from one place. Keeping a
            second table mechanism meant fixing each of those twice, and the
            column resize handle went missing from one of them for exactly
            that reason.
        -->

        <!-- ========================= TabControl ========================= -->
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="FontSize"   Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome" Padding="16,9" Margin="0,0,4,0"
                                CornerRadius="6,6,0,0" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Surface}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background"  Value="{DynamicResource Surface}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========================== Expander ========================== -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
        </Style>

        <Style TargetType="RichTextBox">
            <Setter Property="Foreground"     Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background"     Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontFamily"     Value="Segoe UI" />
            <Setter Property="FontSize"       Value="13" />
        </Style>

        <!-- ============================ Card ============================ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="8" />
            <Setter Property="Padding"         Value="16" />
            <Setter Property="Margin"          Value="0,0,0,12" />
        </Style>

        <!-- ========================= Scroll bars ========================
            Implicit, so every scroll viewer in the window takes it: pages,
            lists, tables, text boxes and the drop down of a combo box.

            The Windows default is a wide light grey gutter with arrow buttons,
            painted from system colours rather than from this palette, which
            put a pale stripe down the side of every dark page. This one is a
            thin rounded thumb on a clear track, drawn only from palette keys
            so it follows a theme change like everything else: the border
            colour at rest, the muted text colour under the mouse, the accent
            while it is dragged.

            No arrow buttons. Clicking the track above or below the thumb still
            pages, through the two invisible repeat buttons either side of it,
            and the wheel and keyboard scroll as before.
        -->
        <!--
            The scroll viewer itself, only for the square where two scroll bars
            meet. The Windows template paints it with a system colour this
            palette cannot reach, which left a white square in the corner of
            every dark table that scrolls both ways. This is the same layout
            with that cell left empty, so the background shows through.
        -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0" Grid.Row="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    CanHorizontallyScroll="False"
                                                    CanVerticallyScroll="False" />

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1" Grid.Row="0"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Cursor="Arrow" />

                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Column="0" Grid.Row="1"
                                       Orientation="Horizontal"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Cursor="Arrow" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable"    Value="False" />
            <Setter Property="IsTabStop"    Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Focusable"    Value="False" />
            <Setter Property="IsTabStop"    Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Grip" CornerRadius="4" Margin="2"
                                Background="{DynamicResource BorderSubtle}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource TextMuted}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width"      Value="10" />
            <Setter Property="MinWidth"   Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Vertical. A vertical Track counts from the bottom, hence the reversal. -->
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                  Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" MinHeight="24" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                  Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width"     Value="Auto" />
                    <Setter Property="MinWidth"  Value="0" />
                    <Setter Property="Height"    Value="10" />
                    <Setter Property="MinHeight" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                          Command="{x:Static ScrollBar.PageLeftCommand}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" MinWidth="24" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPageButton}"
                                                          Command="{x:Static ScrollBar.PageRightCommand}" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================= Header ============================= -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Toolkit" FontSize="19" FontWeight="Bold" />
                    <TextBlock x:Name="HeaderVersion" Text="v1.0.0" Style="{StaticResource Muted}"
                               Margin="10,0,0,0" VerticalAlignment="Bottom" />
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="HeaderHost" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSearch" Content="Search    Ctrl+K" Style="{StaticResource GlyphButton}" Tag="&#xE721;"
                            Margin="0,0,18,0" ToolTip="Find a page, a report, a fix, a tweak, an application, a topic or a vendor command." />
                    <TextBlock Text="Theme" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ThemeSelect" Width="110" Margin="0,0,14,0" />
                    <Border x:Name="ElevationBadge" CornerRadius="4" Padding="10,4" Margin="0,0,10,0"
                            Background="{DynamicResource SurfaceRaised}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <TextBlock x:Name="ElevationText" Text="Standard user" FontSize="12" />
                    </Border>
                    <Button x:Name="BtnElevate" Content="Restart as administrator" Style="{StaticResource GlyphPrimaryButton}" Tag="&#xEA18;" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== Body ============================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
                <!--
                    Grouped by the kind of work rather than listed in the order the
                    pages were written: what is this machine, what is wrong with it,
                    is it secure, and where do I look something up. The groups scroll
                    when the window is short, so no entry is ever cut off.

                    Settings belongs to no group, so it sits below them and never
                    scrolls away. Rows rather than a DockPanel keep the markup in the
                    same order as the rail reads, which a test relies on.
                -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,4,0,8">
                            <!-- Tag carries the icon code point; see the IconFont note above. -->
                            <TextBlock Text="WORKSTATION" Style="{StaticResource NavSection}" />
                            <Button x:Name="NavDashboard"      Content="Dashboard"       Style="{StaticResource NavButton}" Tag="&#xE80F;" />
                            <Button x:Name="NavSystem"         Content="System"          Style="{StaticResource NavButton}" Tag="&#xEC4E;" />
                            <Button x:Name="NavSoftware"       Content="Software"        Style="{StaticResource NavButton}" Tag="&#xECA5;" />
                            <Button x:Name="NavTweaks"         Content="Tweaks"          Style="{StaticResource NavButton}" Tag="&#xE9E9;" />
                            <Button x:Name="NavFixes"          Content="Fixes"           Style="{StaticResource NavButton}" Tag="&#xE90F;" />
                            <Button x:Name="NavIntervention"   Content="Intervention"    Style="{StaticResource NavButton}" Tag="&#xE70F;" />

                            <TextBlock Text="TROUBLESHOOTING" Style="{StaticResource NavSection}" />
                            <Button x:Name="NavPlaybooks"      Content="Playbooks"       Style="{StaticResource NavButton}" Tag="&#xE9D9;" />
                            <Button x:Name="NavDiagnostics"    Content="Diagnostics"     Style="{StaticResource NavButton}" Tag="&#xE95E;" />
                            <Button x:Name="NavNetwork"        Content="Network"         Style="{StaticResource NavButton}" Tag="&#xEC26;" />

                            <TextBlock Text="SECURITY" Style="{StaticResource NavSection}" />
                            <Button x:Name="NavSecurity"       Content="Audit"           Style="{StaticResource NavButton}" Tag="&#xEA18;" />
                            <Button x:Name="NavSecurityTools"  Content="Tools"           Style="{StaticResource NavButton}" Tag="&#xE8D7;" />

                            <TextBlock Text="REFERENCE" Style="{StaticResource NavSection}" />
                            <Button x:Name="NavKnowledge"      Content="Knowledge base"  Style="{StaticResource NavButton}" Tag="&#xE82D;" />
                            <Button x:Name="NavVendorCommands" Content="Commands"        Style="{StaticResource NavButton}" Tag="&#xE756;" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1">
                        <Border Height="1" Margin="16,0,16,6" Background="{DynamicResource BorderSubtle}" />
                        <Button x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButton}" Tag="&#xE713;" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="16,8,16,16">
                        <Button x:Name="BtnOpenLogs" Content="Open log folder" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                        <Button x:Name="BtnAbout"    Content="About"           HorizontalAlignment="Stretch" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Feature panels. Exactly one is visible at a time. -->
            <Grid Grid.Column="1" x:Name="PageHost">

                <!-- ======================== DASHBOARD ======================= -->
                <!--
                    The page the toolkit opens on. System answers "what exactly is
                    this machine"; this one answers "is anything wrong with it, and
                    where do I start", which is how a support call begins.

                    Each card reads on its own and says so until its answer lands.
                -->
                <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Visible">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dashboard" Style="{StaticResource Heading}" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="This workstation at a glance: which machine it is, how it is connected, and whether anything needs attention. Nothing here changes the machine; the actions at the bottom open the page that does the work." />
                            </StackPanel>

                            <Button Grid.Column="1" x:Name="BtnRefreshDashboard" Content="Refresh"
                                    Style="{StaticResource GlyphButton}" Tag="&#xE72C;"
                                    VerticalAlignment="Top" Margin="16,0,0,0" />
                        </Grid>

                        <Grid Margin="0,16,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Workstation -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Workstation" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                    <!-- Shown until this card's part has been read; see Set-TkCardLoading. -->
                                    <StackPanel x:Name="DashWorkstationLoading" Margin="0,2,0,6">
                                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" BorderThickness="0"
                                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" />
                                        <TextBlock x:Name="DashWorkstationLoadingText" Style="{StaticResource Muted}" Text="Reading which machine this is..." />
                                    </StackPanel>
                                    <StackPanel x:Name="DashWorkstationContent" Visibility="Collapsed">
                                        <TextBlock x:Name="DashComputerName" Text="-" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock x:Name="DashModel" Style="{StaticResource Muted}" Margin="0,2,0,12" />
                                        <UniformGrid Columns="2">
                                            <StackPanel><TextBlock Text="Windows"        Style="{StaticResource FieldLabel}" /><TextBlock x:Name="DashOs"         Style="{StaticResource FieldValue}" /></StackPanel>
                                            <StackPanel><TextBlock Text="Uptime"         Style="{StaticResource FieldLabel}" /><TextBlock x:Name="DashUptime"     Style="{StaticResource FieldValue}" /></StackPanel>
                                            <StackPanel><TextBlock Text="Signed in user" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="DashUser"       Style="{StaticResource FieldValue}" /></StackPanel>
                                            <StackPanel><TextBlock Text="Domain"         Style="{StaticResource FieldLabel}" /><TextBlock x:Name="DashDomain"     Style="{StaticResource FieldValue}" /></StackPanel>
                                            <StackPanel><TextBlock Text="Serial number"  Style="{StaticResource FieldLabel}" /><TextBlock x:Name="DashSerial"     Style="{StaticResource FieldValue}" /></StackPanel>
                                            <StackPanel><TextBlock Text="Activation"     Style="{StaticResource FieldLabel}" /><TextBlock x:Name="DashActivation" Style="{StaticResource FieldValue}" /></StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Network -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Network" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                    <!-- Shown until this card's part has been read; see Set-TkCardLoading. -->
                                    <StackPanel x:Name="DashNetworkLoading" Margin="0,2,0,6">
                                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" BorderThickness="0"
                                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" />
                                        <TextBlock x:Name="DashNetworkLoadingText" Style="{StaticResource Muted}" Text="Reading the network adapters and routes..." />
                                    </StackPanel>
                                    <StackPanel x:Name="DashNetworkContent" Visibility="Collapsed">
                                        <TextBlock x:Name="DashIpv4" Text="-" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock x:Name="DashAdapter" Style="{StaticResource Muted}" Margin="0,2,0,12" />
                                        <UniformGrid Columns="2">
                                            <StackPanel><TextBlock Text="Gateway"     Style="{StaticResource FieldLabel}" /><TextBlock x:Name="DashGateway" Style="{StaticResource FieldValue}" /></StackPanel>
                                            <StackPanel><TextBlock Text="DNS servers" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="DashDns"     Style="{StaticResource FieldValue}" /></StackPanel>
                                            <StackPanel><TextBlock Text="Addressing"  Style="{StaticResource FieldLabel}" /><TextBlock x:Name="DashDhcp"    Style="{StaticResource FieldValue}" /></StackPanel>
                                            <StackPanel><TextBlock Text="MAC address" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="DashMac"     Style="{StaticResource FieldValue}" /></StackPanel>
                                        </UniformGrid>
                                        <!--
                                            Ethernet and Wi-Fi up together, a VPN beside the physical
                                            link, virtual switches for VMs and WSL: named or counted here,
                                            so the address above is never mistaken for the only one.
                                        -->
                                        <TextBlock x:Name="DashOtherAdapters" Style="{StaticResource Muted}" Margin="0,0,0,10"
                                                   Visibility="Collapsed" />
                                    </StackPanel>
                                    <!--
                                        Behind a button: it is the one reading that leaves the
                                        machine, so it happens only when the operator asks.
                                    -->
                                    <DockPanel LastChildFill="True">
                                        <Button x:Name="BtnDashPublicIp" DockPanel.Dock="Left" Content="Show public IP"
                                                Style="{StaticResource GlyphButton}" Tag="&#xE774;" Margin="0"
                                                ToolTip="Asks an outside service which address this network is seen from. Only when you press it, because the request leaves the machine." />
                                        <TextBlock x:Name="DashPublicIp" Style="{StaticResource FieldValue}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Health -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Health" Style="{StaticResource SubHeading}" Margin="0,0,0,10" />
                                <!-- Shown until this card's part has been read; see Set-TkCardLoading. -->
                                <StackPanel x:Name="DashHealthCardLoading" Margin="0,2,0,6">
                                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" BorderThickness="0"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" />
                                    <TextBlock x:Name="DashHealthCardLoadingText" Style="{StaticResource Muted}" Text="Reading restart state, updates, disks and battery..." />
                                </StackPanel>
                                <StackPanel x:Name="DashHealthCardContent" Visibility="Collapsed">
                                    <UniformGrid x:Name="DashHealth" Columns="4" />
                                    <TextBlock x:Name="DashHealthNote" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quick actions -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Quick actions" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                <UniformGrid x:Name="DashQuickActions" Columns="4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========================= SYSTEM ========================= -->
                <ScrollViewer x:Name="PageSystem" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="System" Style="{StaticResource Heading}" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="Machine identity read from SMBIOS, operating system state and platform security posture. Everything on this page is read only and works without elevation." />
                            </StackPanel>

                            <!--
                                Only the actions that concern the whole page stay up here.
                                An action on one value sits beside that value: copy next to
                                the serial number, the support site next to the manufacturer,
                                the firmware utility inside the Firmware card.
                            -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0">
                                <Button x:Name="BtnRefreshSystem" Content="Refresh"       Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE72C;" />
                                <Button x:Name="BtnExportReport"  Content="Export report" Style="{StaticResource GlyphButton}"        Tag="&#xE74E;" />
                            </StackPanel>
                        </Grid>

                        <!-- Identity. The quick actions live on the Dashboard only. -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,12">
                            <StackPanel>
                                <TextBlock Text="Identity" Style="{StaticResource SubHeading}" Margin="0,0,0,10" />
                                <!-- Shown until this card's part has been read; see Set-TkCardLoading. -->
                                <StackPanel x:Name="SystemIdentityLoading" Margin="0,2,0,6">
                                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" BorderThickness="0"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" />
                                    <TextBlock x:Name="SystemIdentityLoadingText" Style="{StaticResource Muted}" Text="Reading the machine identity from SMBIOS..." />
                                </StackPanel>
                                <UniformGrid Columns="4" x:Name="SystemIdentityContent" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Manufacturer" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock x:Name="ValManufacturer" Style="{StaticResource FieldValue}" Margin="0" VerticalAlignment="Center" />
                                            <Button x:Name="BtnVendorDrivers" Style="{StaticResource InlineGlyphButton}" Tag="&#xE71B;" Margin="6,0,0,0"
                                                    ToolTip="Open the manufacturer's driver and support page for this model" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel><TextBlock Text="Model" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValModel" Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Serial number" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock x:Name="ValSerial" Style="{StaticResource FieldValue}" Margin="0" VerticalAlignment="Center" />
                                            <Button x:Name="BtnCopySerial" Style="{StaticResource InlineGlyphButton}" Tag="&#xE8C8;" Margin="6,0,0,0"
                                                    IsEnabled="False" ToolTip="Copy the serial number" />
                                            <Button x:Name="BtnVendorWarranty" Style="{StaticResource InlineGlyphButton}" Tag="&#xE8A7;" Margin="2,0,0,0"
                                                    IsEnabled="False" ToolTip="Check the warranty for this serial number on the manufacturer's site" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel><TextBlock Text="Asset tag"      Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValAssetTag" Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Chassis"        Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValChassis"  Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Motherboard"    Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBoard"    Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Domain"         Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValDomain"   Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Signed in user" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValUser"     Style="{StaticResource FieldValue}" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Firmware -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Firmware" Style="{StaticResource SubHeading}" Margin="0,0,0,10" />
                                <!-- Shown until this card's part has been read; see Set-TkCardLoading. -->
                                <StackPanel x:Name="SystemFirmwareLoading" Margin="0,2,0,6">
                                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" BorderThickness="0"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" />
                                    <TextBlock x:Name="SystemFirmwareLoadingText" Style="{StaticResource Muted}" Text="Reading the firmware..." />
                                </StackPanel>
                                <StackPanel x:Name="SystemFirmwareContent" Visibility="Collapsed">
                                    <UniformGrid Columns="4">
                                        <StackPanel><TextBlock Text="BIOS vendor"  Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBiosVendor"  Style="{StaticResource FieldValue}" /></StackPanel>
                                        <StackPanel><TextBlock Text="BIOS version" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBiosVersion" Style="{StaticResource FieldValue}" /></StackPanel>
                                        <StackPanel><TextBlock Text="Release date" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBiosDate"    Style="{StaticResource FieldValue}" /></StackPanel>
                                        <StackPanel><TextBlock Text="Age"          Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBiosAge"     Style="{StaticResource FieldValue}" /></StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="ValBiosAdvice" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                    <!--
                                        The utility button only appears when the catalog knows one
                                        for this manufacturer; the hint beside it says what happens
                                        either way.
                                    -->
                                    <DockPanel Margin="0,10,0,0" LastChildFill="True">
                                        <Button x:Name="BtnVendorTool" DockPanel.Dock="Left" Content="Install the firmware utility"
                                                Style="{StaticResource GlyphButton}" Tag="&#xE896;" Margin="0,0,12,0" Visibility="Collapsed" />
                                        <TextBlock x:Name="ValVendorToolHint" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Text="The toolkit never downloads or flashes firmware itself: it installs the manufacturer's utility, which takes over from there." />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Operating system -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Operating system" Style="{StaticResource SubHeading}" Margin="0,0,0,10" />
                                <!-- Shown until this card's part has been read; see Set-TkCardLoading. -->
                                <StackPanel x:Name="SystemOsLoading" Margin="0,2,0,6">
                                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" BorderThickness="0"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" />
                                    <TextBlock x:Name="SystemOsLoadingText" Style="{StaticResource Muted}" Text="Reading the operating system..." />
                                </StackPanel>
                                <UniformGrid Columns="4" x:Name="SystemOsContent" Visibility="Collapsed">
                                    <StackPanel><TextBlock Text="Edition"    Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValOsCaption"  Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Version"    Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValOsVersion"  Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Build"      Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValOsBuild"    Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Activation" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValActivation" Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Installed"  Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValInstalled"  Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Uptime"     Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValUptime"     Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Time zone"  Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValTimeZone"   Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="PowerShell" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValPowerShell" Style="{StaticResource FieldValue}" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Hardware -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Hardware" Style="{StaticResource SubHeading}" Margin="0,0,0,10" />
                                <!-- Shown until this card's part has been read; see Set-TkCardLoading. -->
                                <StackPanel x:Name="SystemHardwareLoading" Margin="0,2,0,6">
                                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" BorderThickness="0"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" />
                                    <TextBlock x:Name="SystemHardwareLoadingText" Style="{StaticResource Muted}" Text="Reading processors, memory, disks and volumes..." />
                                </StackPanel>
                                <StackPanel x:Name="SystemHardwareContent" Visibility="Collapsed">
                                    <UniformGrid Columns="4">
                                        <StackPanel><TextBlock Text="Processor" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValCpu"    Style="{StaticResource FieldValue}" /></StackPanel>
                                        <StackPanel><TextBlock Text="Cores"     Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValCores"  Style="{StaticResource FieldValue}" /></StackPanel>
                                        <StackPanel><TextBlock Text="Memory"    Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValMemory" Style="{StaticResource FieldValue}" /></StackPanel>
                                        <StackPanel><TextBlock Text="Graphics"  Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValGpu"    Style="{StaticResource FieldValue}" /></StackPanel>
                                    </UniformGrid>

                                    <!--
                                        Every fixed volume, one bar each, the system drive first. A
                                        bar reads faster than a percentage in a table, and seeing all
                                        of them at once is the point: the drive filling up is rarely
                                        the one a selector happens to show. Rows are drawn in code by
                                        Write-TkSystemVolumeList, one per volume the machine reports.
                                    -->
                                    <TextBlock Text="Disk space" Style="{StaticResource FieldLabel}" Margin="0,4,0,6" />
                                    <StackPanel x:Name="SystemVolumeList" />

                                    <!--
                                        Rendered by the shared table builder rather than a GridView.
                                        One renderer means one set of behaviours everywhere:
                                        selectable cells, banded rows, draggable column edges and a
                                        palette that follows a theme change.
                                    -->
                                    <TextBlock Text="Physical disks" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                                    <RichTextBox x:Name="DocDisks" IsReadOnly="True" MaxHeight="200"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Platform security -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Platform security" Style="{StaticResource SubHeading}" Margin="0,0,0,10" />
                                <!-- Shown until this card's part has been read; see Set-TkCardLoading. -->
                                <StackPanel x:Name="SystemSecurityLoading" Margin="0,2,0,6">
                                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8" BorderThickness="0"
                                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource SurfaceRaised}" />
                                    <TextBlock x:Name="SystemSecurityLoadingText" Style="{StaticResource Muted}" Text="Reading Secure Boot, TPM, BitLocker, firewall and antivirus..." />
                                </StackPanel>
                                <UniformGrid Columns="3" x:Name="SystemSecurityContent" Visibility="Collapsed">
                                    <StackPanel><TextBlock Text="Secure Boot"        Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValSecureBoot" Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="TPM"                Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValTpm"        Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="BitLocker"          Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValBitLocker"  Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Firewall"           Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValFirewall"   Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Antivirus or EDR"   Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValAntivirus"  Style="{StaticResource FieldValue}" /></StackPanel>
                                    <StackPanel><TextBlock Text="Microsoft Defender" Style="{StaticResource FieldLabel}" /><TextBlock x:Name="ValDefender"   Style="{StaticResource FieldValue}" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================== SOFTWARE ======================== -->
                <Grid x:Name="PageSoftware" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Software" Style="{StaticResource Heading}" />
                        <TextBlock x:Name="WingetStatusText" Style="{StaticResource Muted}"
                                   Text="Applications through winget, from the official Microsoft source; and the updates Windows Update has for this machine." />
                    </StackPanel>

                    <TabControl Grid.Row="1" x:Name="SoftwareTabs" Background="Transparent" BorderThickness="0" Margin="0,14,0,0">
                        <TabItem Header="Applications">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="SoftwareSearch" Tag="Search applications by name, description or package id" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" x:Name="SoftwareCategory" Width="200" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnInstallSelected"   Content="Install selected" Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE896;" />
                            <Button x:Name="BtnUninstallSelected" Content="Uninstall"        Style="{StaticResource GlyphButton}" Tag="&#xE74D;" />
                            <Button x:Name="BtnUpgradeAll"        Content="Upgrade all"      Style="{StaticResource GlyphButton}" Tag="&#xE895;" />
                            <Button x:Name="BtnRefreshInstalled"  Content="Refresh state"    Style="{StaticResource GlyphButton}" Tag="&#xE72C;" />
                            <Button x:Name="BtnClearSelection"    Content="Clear"            Style="{StaticResource GlyphButton}" Tag="&#xE711;" Margin="0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="SoftwareList">
                                <!--
                                    Two columns when there is room for two,
                                    one when there is not. A hundred and forty
                                    full width rows is a lot of scrolling for
                                    a list whose entries are a name and a
                                    line of description; Initialize-TkSoftware
                                    Page sets Columns from the panel width.
                                -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid x:Name="SoftwarePanel" Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            The whole card is the toggle. A
                                            checkbox in the corner makes a
                                            large clickable area behave like a
                                            small one, and selecting twenty
                                            applications means twenty small
                                            targets instead of twenty large.
                                        -->
                                        <ToggleButton Style="{StaticResource AppCard}"
                                                      ToolTip="{Binding PackageId}">
                                            <ToggleButton.IsChecked>
                                                <Binding Path="IsSelected" Mode="TwoWay" />
                                            </ToggleButton.IsChecked>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!--
                                                    The real publisher icon
                                                    when the catalogue has
                                                    one, the category icon
                                                    otherwise. Exactly one of
                                                    the two is ever visible.
                                                -->
                                                <Border Grid.Column="0" Style="{StaticResource ItemTile}"
                                                        Background="{Binding TileBrush}">
                                                    <Grid>
                                                        <TextBlock x:Name="CategoryGlyph"
                                                                   Text="{Binding Glyph}"
                                                                   Style="{StaticResource TileGlyph}" />
                                                        <Path x:Name="BrandIcon"
                                                              Data="{Binding IconGeometry}"
                                                              Fill="White" Stretch="Uniform"
                                                              Width="17" Height="17"
                                                              Visibility="Collapsed"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <!--
                                                        The package identifier
                                                        moved to the card's
                                                        tooltip: it is what
                                                        you check once, not
                                                        what you read down a
                                                        list.
                                                    -->
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}"
                                                               Style="{StaticResource ItemState}"
                                                               VerticalAlignment="Center" Margin="8,0,8,0" />
                                                    <Path x:Name="SelectedMark" Width="14" Height="14"
                                                          Stretch="Uniform" Visibility="Hidden"
                                                          Fill="{DynamicResource Accent}"
                                                          Data="M 6 11.2 L 1.8 7 L 0.4 8.4 L 6 14 L 18 2 L 16.6 0.6 Z" />
                                                </StackPanel>
                                            </Grid>
                                        </ToggleButton>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                <Setter TargetName="BrandIcon"     Property="Visibility" Value="Visible" />
                                                <Setter TargetName="CategoryGlyph" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Windows Update">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="BtnCheckUpdates"   Content="Check for updates" Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE72C;" />
                                    <Button x:Name="BtnInstallUpdates" Content="Install selected"  Style="{StaticResource GlyphButton}" Tag="&#xE896;" Margin="0,0,16,0" />
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                               Text="Checking reads only. Installing changes the machine, needs administrator rights, and asks first." />
                                </StackPanel>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" Padding="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="UpdateList" Margin="8">
                                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                       Text="Select Check for updates to ask Windows Update what is available. Nothing is downloaded or installed until you choose updates and confirm." />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ========================= TWEAKS ========================= -->
                <Grid x:Name="PageTweaks" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Tweaks" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Every tweak declares both the applied state and the state to restore, so each one can be reverted. A system restore point is created before a batch is applied." />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,14,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="TweakSearch" Tag="Search tweaks" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" x:Name="TweakCategory" Width="200" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BtnApplyTweaks"   Content="Apply selected" Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE73E;" />
                            <Button x:Name="BtnRevertTweaks"  Content="Revert selected" Style="{StaticResource GlyphButton}" Tag="&#xE7A7;" />
                            <Button x:Name="BtnRefreshTweaks" Content="Refresh state"  Style="{StaticResource GlyphButton}" Tag="&#xE72C;" Margin="0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TweakList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            Same card as the Software list:
                                            the whole row is the toggle. Two
                                            lists that do the same thing
                                            should not be operated in two
                                            different ways.
                                        -->
                                        <ToggleButton Style="{StaticResource AppCard}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource ItemTile}"
                                                        Background="{Binding TileBrush}">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource TileGlyph}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                                        <Border CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                                                                Background="{DynamicResource Surface}"
                                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                            <TextBlock Text="{Binding Impact}" Style="{StaticResource ItemBadge}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}"
                                                               Style="{StaticResource ItemState}"
                                                               VerticalAlignment="Center" Margin="12,0,10,0" />
                                                    <Path x:Name="SelectedMark" Width="15" Height="15"
                                                          Stretch="Uniform" Visibility="Hidden"
                                                          Fill="{DynamicResource Accent}"
                                                          Data="M 6 11.2 L 1.8 7 L 0.4 8.4 L 6 14 L 18 2 L 16.6 0.6 Z" />
                                                </StackPanel>
                                            </Grid>
                                        </ToggleButton>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ========================== FIXES ========================== -->
                <Grid x:Name="PageFixes" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Fixes" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Repair actions with the symptom each one addresses. Read the note before running anything marked high risk." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="BtnAutoLogon"     Content="Automatic logon" Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE8D7;" />
                            <Button x:Name="BtnRestorePoint"  Content="Create a restore point" Style="{StaticResource GlyphButton}" Tag="&#xE74E;" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="FixList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!--
                                            The same card shape as Software
                                            and Tweaks, but a plain border
                                            rather than a toggle: a fix is
                                            run, not selected, so there is
                                            nothing for a checked state to
                                            mean. The Run button keeps the
                                            plain style because its Tag
                                            carries the fix identifier.
                                        -->
                                        <Button Style="{StaticResource ActionCard}"
                                                Tag="{Binding Id}"
                                                IsEnabled="{Binding CanRun}"
                                                ToolTip="{Binding RunTooltip}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Style="{StaticResource ItemTile}"
                                                        Background="{Binding TileBrush}">
                                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource TileGlyph}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                                        <Border CornerRadius="3" Padding="6,1" Margin="10,0,0,0"
                                                                Background="{DynamicResource Surface}"
                                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                                            <TextBlock Text="{Binding RiskText}" Style="{StaticResource ItemBadge}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding WhenToUse}" Style="{StaticResource Muted}"
                                                               Margin="0,3,0,0" FontStyle="Italic" Opacity="0.8" />
                                                </StackPanel>

                                                <!-- Says the row is the target. -->
                                                <TextBlock Grid.Column="2" Text="&#xE76C;"
                                                           Style="{StaticResource Glyph}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           VerticalAlignment="Center" Margin="4,0,2,0" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ========================= NETWORK ========================= -->
                <Grid x:Name="PageNetwork" Margin="24,20" Visibility="Collapsed">
                    <TabControl x:Name="NetworkTabs" Background="Transparent" BorderThickness="0">

                        <TabItem Header="Subnet calculator">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16,0,0">
                                <StackPanel>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="IPv4 subnet" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="SubnetInput" Tag="IPv4 or IPv6, e.g. 192.168.1.10/24 or 2001:db8::1/64" Width="260" Text="192.168.1.10/24" />
                                                <Button x:Name="BtnCalculateSubnet" Content="Calculate" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" />
                                                <TextBox x:Name="SplitPrefixInput" Tag="New prefix" Width="70" Margin="20,0,0,0" Text="26" />
                                                <Button x:Name="BtnSplitSubnet" Content="Split into" Margin="8,0,0,0" />
                                                <TextBox x:Name="HostCountInput" Tag="Hosts needed" Width="90" Margin="20,0,0,0" Text="300" />
                                                <Button x:Name="BtnPrefixForHosts" Content="Prefix for hosts" Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                                       Text="Accepts IPv4 or IPv6, in CIDR notation or with a mask. The family is detected from the address. /31 point to point links and /32 host routes follow RFC 3021; IPv6 prefixes report their scope and interface identifier." />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="IPv6 unique local prefix" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                            <WrapPanel>
                                                <TextBlock Text="Subnets to list" VerticalAlignment="Center" Margin="0,0,8,8" />
                                                <TextBox x:Name="UlaSubnetCount" Width="70" Text="4" Margin="0,0,10,8" />
                                                <Button x:Name="BtnGenerateUla" Content="Generate a ULA prefix" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                                            </WrapPanel>
                                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                       Text="A random /48 in fd00::/8, as RFC 4193 asks, for a lab, a site to site VPN or internal services that must keep their addresses when the provider prefix changes. Random is the point: two networks that are joined later do not collide. Unique local addresses are not routed on the internet." />
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <TextBox x:Name="SubnetOutput" Style="{StaticResource Mono}" Height="380"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 AcceptsReturn="True" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Adapters">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Button x:Name="BtnRefreshAdapters" Content="Refresh"
                                                    Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE72C;" />
                                            <Button x:Name="BtnPublicIp" Content="Show public address"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xEC27;"
                                                    ToolTip="Asks an external service what address the internet sees. The answer appears in the field on the right." />
                                            <Button x:Name="BtnListeningPorts" Content="Listening ports"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xE7F4;"
                                                    ToolTip="Opens the listening sockets in a window of their own, so this tab keeps its place." />
                                        </StackPanel>

                                        <!--
                                            The public address is shown here
                                            rather than only in the console.
                                            The console is collapsed by
                                            default, so an answer written
                                            only there is an answer nobody
                                            sees.
                                        -->
                                        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="{DynamicResource InputBackground}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                CornerRadius="5" Padding="12,7" Margin="16,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Public address" Style="{StaticResource FieldLabel}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox x:Name="PublicAddressValue"
                                                         Style="{StaticResource SelectableText}"
                                                         FontFamily="Cascadia Mono, Consolas"
                                                         FontSize="13" MinWidth="130"
                                                         Text="not queried yet" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="DocAdapters" IsReadOnly="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Diagnostics">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Reachability -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DiagLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Target" Style="{StaticResource FormLabel}" />
                                            <TextBox Grid.Column="1" x:Name="DiagTarget" Width="260"
                                                     Tag="Host, or a network in CIDR form for the sweep"
                                                     Text="192.168.1.1" />

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnTestConnectivity" Content="Connectivity chain"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Gateway, DNS and internet in order, so the first broken hop is the answer." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnPortScan" Content="Common ports"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Tries the usual service ports on that one host." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnSweep" Content="Sweep subnet"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Pings every address of the network written in CIDR form. Refuses anything wider than /22." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Name resolution -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DiagLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="DNS name" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="DnsName" Tag="Name to resolve" Width="260"
                                                         Text="www.microsoft.com" />
                                                <ComboBox x:Name="DnsType" Width="90" Margin="8,0,0,0"
                                                          ToolTip="Record type to ask for." />
                                                <TextBox x:Name="DnsServer" Tag="Server (optional)" Width="150" Margin="8,0,0,0"
                                                         ToolTip="Ask this resolver instead of the one the adapter is configured with. Useful for comparing an internal answer with a public one." />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <Button x:Name="BtnResolveDns" Content="Resolve"
                                                        Style="{StaticResource GroupedPrimaryButton}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="2" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                                   Text="Port checks and sweeps are for networks you administer. The sweep refuses any prefix shorter than /22 and every target is written to the log." />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="NetworkOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Admin tools">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Path behaviour -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AdminLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Host" Style="{StaticResource FormLabel}" />
                                            <TextBox Grid.Column="1" x:Name="AdminTarget" Width="260"
                                                     Tag="Host name or IP address" Text="8.8.8.8" />

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnPathMtu" Content="Path MTU"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Finds the largest packet that survives the path. Explains a link that connects but stalls on large transfers." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnLinkQuality" Content="Link quality"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Loss and jitter over a run of probes, which an average latency hides." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnTraceRoute" Content="Trace route"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Every hop between here and the host." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Transport security -->
                                        <Grid Grid.Row="1" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AdminLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="TLS" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="TlsHost" Tag="Host name" Width="260"
                                                         Text="www.microsoft.com" />
                                                <TextBox x:Name="TlsPort" Tag="Port" Width="80" Margin="8,0,0,0"
                                                         Text="443" ToolTip="Port to open the session on." />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <Button x:Name="BtnTlsCertificate" Content="Inspect certificate"
                                                        Style="{StaticResource GroupedPrimaryButton}"
                                                        ToolTip="Subject, issuer, validity and signature algorithm of the certificate that host presents." />
                                            </Border>
                                        </Grid>

                                        <!-- Layer two -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="AdminLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="MAC" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="WolMac" Tag="MAC 00:1A:2B:3C:4D:5E" Width="260" />
                                                <TextBox x:Name="WolBroadcast" Tag="Broadcast address" Width="160" Margin="8,0,0,0"
                                                         Text="255.255.255.255"
                                                         ToolTip="Wake-on-LAN needs the directed broadcast of the target subnet when the packet has to cross a router." />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnMacVendor" Content="Look up vendor"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Who made the network card with this MAC address, from the IEEE registry built into the toolkit, and what kind of address it is: burned in, randomised, multicast or a virtual router." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnWakeOnLan" Content="Send magic packet"
                                                            Style="{StaticResource GroupedButton}" />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnNeighbours" Content="Neighbour table"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="The local ARP and neighbour cache: which MAC answers for which address." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnSwitchPort" Content="Switch port"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Listens about a minute for the LLDP or CDP announcement of the switch this machine is plugged into: switch name, port, VLAN and management address. Needs administrator rights." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                                                   Text="Hover any action for what it reports. Everything on this tab is read only except the magic packet, which only asks a machine to power on. Switch port listens with Packet Monitor for about a minute and needs administrator rights." />
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="AdminOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Configuration">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="Adapter IP profiles"
                                                   Style="{StaticResource SubHeading}" Margin="0,0,0,8" />

                                        <!-- Pick an adapter and a saved profile, then apply it. -->
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Adapter" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <ComboBox x:Name="ProfileAdapter" Width="230"
                                                          ToolTip="The adapter a profile is applied to." />
                                                <ComboBox x:Name="ProfileSelect" Width="230" Margin="8,0,0,0"
                                                          ToolTip="A profile saved earlier." />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnApplyProfile" Content="Apply"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Writes the selected profile onto the selected adapter." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnDeleteProfile" Content="Delete"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Removes the saved profile. Does not change the adapter." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Compose a new profile. -->
                                        <Grid Grid.Row="2" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="New profile" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ProfileName" Width="180"
                                                         Tag="Name, e.g. Site Lyon VLAN 30" />
                                                <TextBox x:Name="ProfileAddress" Width="140" Margin="8,0,0,0"
                                                         Tag="Address" ToolTip="Address 192.168.50.10" />
                                                <TextBox x:Name="ProfilePrefix" Width="56" Margin="6,0,0,0"
                                                         Text="24" Tag="/" ToolTip="Prefix length" />
                                                <TextBox x:Name="ProfileGateway" Width="140" Margin="6,0,0,0"
                                                         Tag="Gateway" ToolTip="Gateway 192.168.50.1" />
                                                <TextBox x:Name="ProfileDns" Width="170" Margin="6,0,0,0"
                                                         Tag="DNS servers" ToolTip="Separated by commas: 1.1.1.1, 9.9.9.9" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnSaveProfile" Content="Save static"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Saves the fields on the left as a fixed address profile." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnSaveDhcpProfile" Content="Save DHCP"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Saves a profile that puts the adapter back on DHCP. Only the name is used." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnCaptureProfile" Content="Capture current"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Fills the fields from what the selected adapter is configured with right now." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <TextBlock Grid.Row="3" Style="{StaticResource Muted}" Margin="0,0,0,4"
                                                   Text="Applying a profile to the adapter carrying your remote session will disconnect it." />

                                        <TextBlock Grid.Row="4" Text="Routes and port forwarding"
                                                   Style="{StaticResource SubHeading}" />

                                        <Grid Grid.Row="5" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Route" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="RoutePrefix" Width="180"
                                                         Tag="Destination" ToolTip="In CIDR form: 10.50.0.0/16" />
                                                <TextBox x:Name="RouteNextHop" Width="150" Margin="8,0,0,0"
                                                         Tag="Next hop" ToolTip="The router that reaches it: 192.168.1.254" />
                                                <ComboBox x:Name="RouteAdapter" Width="190" Margin="8,0,0,0"
                                                          ToolTip="The adapter the route leaves by." />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnAddRoute" Content="Add persistent"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Adds the route and keeps it across restarts." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnRemoveRoute" Content="Remove"
                                                            Style="{StaticResource GroupedButton}" />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnShowRoutes" Content="Show table"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="The whole routing table, in a window of its own." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Grid.Row="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="ConfigLabel" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Forward" Style="{StaticResource FormLabel}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox x:Name="ProxyListenPort" Width="100"
                                                         Tag="Listen port" ToolTip="The port opened on this machine, e.g. 8080" />
                                                <TextBlock Text="to" Style="{StaticResource FormLabel}" Margin="10,0,10,0" />
                                                <TextBox x:Name="ProxyConnectAddress" Width="170"
                                                         Tag="Forward to" ToolTip="Destination address: 172.28.5.2" />
                                                <TextBox x:Name="ProxyConnectPort" Width="100" Margin="8,0,0,0"
                                                         Tag="Port" ToolTip="Destination port, e.g. 80" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Style="{StaticResource ActionGroup}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnAddProxy" Content="Publish"
                                                            Style="{StaticResource GroupedPrimaryButton}"
                                                            ToolTip="Opens the listening port and forwards it. Remember the firewall rule." />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnRemoveProxy" Content="Remove"
                                                            Style="{StaticResource GroupedButton}" />
                                                    <Rectangle Style="{StaticResource GroupDivider}" />
                                                    <Button x:Name="BtnShowProxies" Content="Show rules"
                                                            Style="{StaticResource GroupedButton}"
                                                            ToolTip="Every forwarding rule on this machine, in a window of its own." />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="ConfigOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>

                <!-- ======================= DIAGNOSTICS ======================= -->
                <!--
                    Reports and hardware tests on one page. Both answer "what is wrong
                    with this machine": one by reading it, the other by asking the
                    operator to look, listen and press. Two pages for one question sent
                    people to the wrong one first.
                -->
                <Grid x:Name="PageDiagnostics" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Diagnostics" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="What a support call needs answered, and the parts a report cannot judge. Everything here is read only: a tool that changes things while you are still looking destroys the evidence." />
                    </StackPanel>

                    <TabControl Grid.Row="1" x:Name="DiagnosticsTabs" Background="Transparent" BorderThickness="0">

                        <TabItem Header="Reports">
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="270" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DockPanel Grid.Column="0" Margin="0,0,16,0" LastChildFill="True">
                                    <Button x:Name="BtnDiagExport" DockPanel.Dock="Bottom"
                                            Content="Export the last report" Margin="0,6,0,0"
                                            HorizontalAlignment="Stretch" />
                                    <Button x:Name="BtnSupportBundle" DockPanel.Dock="Bottom"
                                            Content="Create support bundle (ZIP)" Margin="0,10,0,0"
                                            Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE74E;"
                                            HorizontalAlignment="Stretch"
                                            ToolTip="Collects the system, network, diagnostics, security posture and log into one timestamped ZIP to attach to a ticket. Nothing is changed, and nothing leaves the machine until you send it." />
                                    <ListBox x:Name="DiagnosticChoices" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000">
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Every check below, in order.">
                                            <TextBlock Text="Full check" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="All six places Windows records one, including the invisible ones.">
                                            <TextBlock Text="Pending reboot" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Reliability counters joined to free space, with SSD wear.">
                                            <TextBlock Text="Storage health" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Where the space went: how full each drive is, the biggest folders and files on the system drive, and the caches safe to empty, each with its size. Nothing is deleted.">
                                            <TextBlock Text="Disk space" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="What uses the processor, memory and disks right now, the programs that start with Windows, and how long start up takes and what slows it.">
                                            <TextBlock Text="Performance" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Every device Device Manager flags, with its problem code explained and what to try.">
                                            <TextBlock Text="Devices" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Blue screens with their stop code explained and the drivers registered before them, hard resets, and repeated application faults.">
                                            <TextBlock Text="Crashes" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Signal, band and channel, link rate, security, how crowded the channel is, and how often the connection dropped.">
                                            <TextBlock Text="Wi-Fi" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="The proxy applications, services and command line tools each use, whether it answers, and what automatic detection finds.">
                                            <TextBlock Text="Proxy" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Domain, Microsoft Entra and Intune: how the device is joined, its single sign-on token, the domain controller and clock, and the MDM.">
                                            <TextBlock Text="Sign-in and management" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Through the update session, so driver and feature updates appear.">
                                            <TextBlock Text="Update history" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Whether this Windows release and the installed programs still receive security fixes, and what to move to when they do not.">
                                            <TextBlock Text="Software support" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Spooler, printers, ports, drivers and queue depth.">
                                            <TextBlock Text="Printing" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Profile sizes, mapped drives and logon timing. The domain is under Sign-in and management.">
                                            <TextBlock Text="Profiles and policy" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="The local users and groups: who can sign in, whose password never expires or is not required, and who is a local administrator.">
                                            <TextBlock Text="Local accounts" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Which Group Policy objects applied to this machine and user, and which were filtered out, from gpresult. The computer side needs administrator rights.">
                                            <TextBlock Text="Group Policy" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                    </ListBox>
                                </DockPanel>

                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="DiagnosticsOutput" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 IsDocumentEnabled="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Hardware tests">
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ListBox Grid.Column="0" x:Name="HardwareChoices" Margin="0,0,14,0"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000">
                                    <ListBoxItem Style="{StaticResource ReportChoice}"
                                                 ToolTip="Every key on the board, ticked off as you press it, while this window has focus.">
                                        <TextBlock Text="Keyboard" Style="{StaticResource ChoiceTitle}" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource ReportChoice}"
                                                 ToolTip="Full screen colours for dead and stuck pixels, a gradient for banding, and a grid for geometry.">
                                        <TextBlock Text="Display" Style="{StaticResource ChoiceTitle}" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource ReportChoice}"
                                                 ToolTip="A tone in one channel at a time, which is the only way to catch a dead speaker.">
                                        <TextBlock Text="Sound" Style="{StaticResource ChoiceTitle}" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource ReportChoice}"
                                                 ToolTip="What the pack holds now against what it was built to hold, and the Windows battery report.">
                                        <TextBlock Text="Battery" Style="{StaticResource ChoiceTitle}" />
                                    </ListBoxItem>
                                    <ListBoxItem Style="{StaticResource ReportChoice}"
                                                 ToolTip="Memory slot by slot, and the panels attached to this machine.">
                                        <TextBlock Text="Memory and displays" Style="{StaticResource ChoiceTitle}" />
                                    </ListBoxItem>
                                </ListBox>

                                <!-- ============================ Keyboard ============================ -->
                                <Border Grid.Column="1" x:Name="PanelKeyboard" Style="{StaticResource Card}" Margin="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--
                                            No start button. The test runs from the
                                            moment this panel is open, because pressing
                                            a key is the only thing it ever needed the
                                            operator to do.
                                        -->
                                        <Grid Grid.Row="0" Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox Grid.Column="0" x:Name="KeyboardLayout" Width="230"
                                                      ToolTip="Changes what is printed on the keys. The keys themselves are matched by physical position, so the results stay valid whichever layout you draw." />

                                            <TextBlock Grid.Column="1" x:Name="KeyboardProgress"
                                                       Style="{StaticResource FieldValue}"
                                                       VerticalAlignment="Center" Margin="16,0,16,0"
                                                       Text="0 of 105 keys" />

                                            <Button Grid.Column="2" x:Name="BtnKeyboardReset" Content="Reset"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xE72C;" Margin="0" />
                                        </Grid>

                                        <Border Grid.Row="1" Margin="0,0,0,10" CornerRadius="6" Padding="11,8"
                                                Background="{DynamicResource SurfaceRaised}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                            <TextBlock x:Name="KeyboardHint" Style="{StaticResource Muted}"
                                                       Text="Press every key; each lights up as it registers. The test runs while this panel is open and stops when you leave it, or on Escape pressed twice. The Windows key, Alt+Tab and Ctrl+Alt+Delete are claimed by Windows before any application sees them, so they will not light up: this test reads keys only while its own window is focused, which is why nothing mistakes it for a keylogger." />
                                        </Border>

                                        <!--
                                            Shrinks the board to the width it is given and never
                                            enlarges it. Inside the Hardware tests tab, beside the
                                            test list, a 105 key board is wider than the card on an
                                            ordinary window, and a keyboard scrolled sideways hides
                                            the keypad you are asked to press.

                                            The scroll viewer bounds the width and leaves the height
                                            open, so the scale follows the width alone. A short
                                            window scrolls the board rather than shrinking the
                                            legends until they cannot be read.
                                        -->
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                                     HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <StackPanel x:Name="KeyboardSurface" />
                                            </Viewbox>
                                        </ScrollViewer>

                                        <TextBlock Grid.Row="3" x:Name="KeyboardResult" Style="{StaticResource Muted}"
                                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <!-- ============================ Display ============================= -->
                                <Border Grid.Column="1" x:Name="PanelDisplay" Style="{StaticResource Card}" Margin="0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Display" Style="{StaticResource SubHeading}" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                                                   Text="Each test fills the screen. Click or press any key to move to the next one, Escape to leave. Look at the panel from straight on and from an angle: a stuck pixel stays one colour on every screen, a reflection does not." />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Button x:Name="BtnDisplayColours" Content="Solid colours"
                                                    Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE790;"
                                                    ToolTip="White, black, red, green and blue in turn. A dead pixel shows black on white; a stuck one shows colour on black." />
                                            <Button x:Name="BtnDisplayGradient" Content="Gradient"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xE7A1;"
                                                    ToolTip="Reveals banding and a panel that cannot render smooth tone." />
                                            <Button x:Name="BtnDisplayGrid" Content="Geometry grid"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xE80A;"
                                                    ToolTip="A one pixel grid. Blurred or uneven lines mean the panel is not running at its native resolution." />
                                        </StackPanel>

                                        <TextBlock Text="Panels attached" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <RichTextBox x:Name="DocDisplays" IsReadOnly="True" MaxHeight="260"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Disabled" />
                                    </StackPanel>
                                </Border>

                                <!-- ============================= Sound ============================== -->
                                <Border Grid.Column="1" x:Name="PanelSound" Style="{StaticResource Card}" Margin="0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Sound" Style="{StaticResource SubHeading}" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                                                   Text="A tone in one channel at a time. Playing the same thing on both channels is how a dead speaker passes a test: if you hear the left tone and the right tone equally, both sides work." />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button x:Name="BtnToneLeft"  Content="Left channel"
                                                    Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE7F6;" />
                                            <Button x:Name="BtnToneRight" Content="Right channel"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xE7F6;" />
                                            <Button x:Name="BtnToneBoth"  Content="Both"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xE995;" />
                                            <Button x:Name="BtnToneSweep" Content="Frequency sweep"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xE9D2;"
                                                    ToolTip="Low to high. A rattle at one pitch is a loose driver or a case panel resonating." />
                                        </StackPanel>

                                        <TextBlock x:Name="SoundStatus" Style="{StaticResource Muted}" Margin="0,0,0,14"
                                                   Text="Turn the volume to a comfortable level first." />

                                        <TextBlock Text="Audio devices" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                                        <RichTextBox x:Name="DocAudio" IsReadOnly="True" MaxHeight="240"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Disabled" />
                                    </StackPanel>
                                </Border>

                                <!-- ============================ Battery ============================= -->
                                <Border Grid.Column="1" x:Name="PanelBattery" Style="{StaticResource Card}" Margin="0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Battery" Style="{StaticResource SubHeading}" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                                                   Text="Health is what the pack holds now against what it was built to hold. Below about eighty per cent a laptop starts feeling unreliable away from the mains, whatever the charge percentage says." />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Button x:Name="BtnBatteryRefresh" Content="Read the battery"
                                                    Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE72C;" />
                                            <Button x:Name="BtnBatteryReport" Content="Full Windows report"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xE9F9;"
                                                    ToolTip="Builds the powercfg battery report, which carries the charge cycles and the recent drain history, and opens it." />
                                        </StackPanel>

                                        <RichTextBox x:Name="DocBattery" IsReadOnly="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Disabled" />
                                    </StackPanel>
                                </Border>

                                <!-- ======================== Memory and displays ===================== -->
                                <Border Grid.Column="1" x:Name="PanelMemory" Style="{StaticResource Card}" Margin="0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Memory" Style="{StaticResource SubHeading}" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14"
                                                   Text="Slot by slot. A machine reporting less memory than it has usually has one module seated badly, and one running slower than expected often has two modules of different speeds. A real memory test needs a restart: the Windows tool below runs before Windows loads, which is the only way to test memory that is not in use." />

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Button x:Name="BtnMemoryRefresh" Content="Read the modules"
                                                    Style="{StaticResource GlyphPrimaryButton}" Tag="&#xE72C;" />
                                            <Button x:Name="BtnMemoryDiagnostic" Content="Schedule the Windows memory test"
                                                    Style="{StaticResource GlyphButton}" Tag="&#xE950;"
                                                    ToolTip="Opens the Windows Memory Diagnostic, which asks whether to restart now or at the next start up." />
                                        </StackPanel>

                                        <RichTextBox x:Name="DocMemory" IsReadOnly="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Disabled" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- ======================== SECURITY ======================== -->
                <!--
                    The examinations of the machine: the posture audit and the threat
                    hunting investigations. The tools that make or check something,
                    keys, hashes and passwords, are on the Tools page beside it.
                -->
                <Grid x:Name="PageSecurity" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Audit" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="How well this machine is protected, and whether something is already running on it that should not be." />
                    </StackPanel>

                    <TabControl Grid.Row="1" x:Name="SecurityTabs" Background="Transparent" BorderThickness="0">

                        <TabItem Header="Security audit">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,10">

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BtnRunAudit"    Content="Run the audit" Style="{StaticResource PrimaryButton}" />
                                        <Button x:Name="BtnExportAudit" Content="Export report" />
                                        <TextBlock Text="Depth" VerticalAlignment="Center" Margin="16,0,8,0" Style="{StaticResource Muted}" />
                                        <ComboBox x:Name="AuditLevel" Width="230" VerticalAlignment="Center"
                                                  ToolTip="Essential covers what goes wrong often and is cheap to fix. Full adds the controls that need a decision, a licence or a domain behind them." />
                                        <Button x:Name="BtnAuditExclusions" Content="Excluded accounts" Margin="10,0,0,0"
                                                ToolTip="Administrator accounts that belong on this machine. They are left out of the account controls and named in the report." />
                                    </StackPanel>

                                    <!--
                                        The score is the first thing read, so it is the first thing
                                        drawn, and it is large enough to be read across a desk.
                                    -->
                                    <Border x:Name="AuditScoreCard" Style="{StaticResource Card}" Margin="0,12,0,0"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                                <TextBlock x:Name="AuditScoreValue" Text="--" FontSize="40" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="out of 100" Style="{StaticResource Muted}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="AuditScoreHeadline" Style="{StaticResource FieldValue}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="AuditSummary" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <Border x:Name="AuditScoreTrack" Height="8" CornerRadius="4" Margin="0,10,0,0"
                                                        Background="{DynamicResource SurfaceRaised}" HorizontalAlignment="Stretch">
                                                    <!--
                                                        Two star columns share the width as score and remainder, so the
                                                        bar stays proportional through any resize with nothing measured
                                                        in code. A measured width read zero whenever the card had just
                                                        been made visible and had not been laid out yet.
                                                    -->
                                                    <Grid x:Name="AuditScoreBar">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0*" />
                                                            <ColumnDefinition Width="100*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border x:Name="AuditScoreFill" Grid.Column="0" CornerRadius="4"
                                                                Background="{DynamicResource Success}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="AuditOutput" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 IsDocumentEnabled="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Threat hunting">
                            <Grid Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="270" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Muted}" Margin="0,0,0,12"
                                           Text="Eight read only investigations. Nothing here changes the machine, which is what makes them safe to run first on a system whose state you do not want to disturb. Some read what only an administrator can: event triage needs the Security log, USB times and incoming Remote Desktop need an elevated instance too." />

                                <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0" LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                        <TextBlock Text="Endpoints to check" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="CertEndpoints" Margin="0,0,0,6"
                                                 Tag="intranet, dc01:636, vpn.example.com" />
                                        <Button x:Name="BtnCheckEndpointCerts" Content="Check certificate expiry"
                                                HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                        <Button x:Name="BtnExportHunt" Content="Export the last report"
                                                HorizontalAlignment="Stretch" Margin="0" />
                                    </StackPanel>

                                    <ListBox x:Name="HuntChoices" Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000">
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Failed logons, lockouts, services installed, logs cleared.">
                                            <TextBlock Text="Event log triage" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Run keys, services, tasks and WMI subscriptions, signature checked.">
                                            <TextBlock Text="Autostart and persistence" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Listening sockets joined to the inbound firewall policy.">
                                            <TextBlock Text="Network exposure" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Machine and user stores: expiry, SHA-1, weak keys.">
                                            <TextBlock Text="Certificate inventory" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Every USB storage device ever connected, with its serial and, when elevated, when it was last plugged in.">
                                            <TextBlock Text="USB history" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="Who connected in with Remote Desktop and from which address, and the servers this account connected out to.">
                                            <TextBlock Text="Remote Desktop history" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="The extensions in Chrome, Edge, Brave and Firefox, with the permissions that reach the most flagged.">
                                            <TextBlock Text="Browser extensions" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                        <ListBoxItem Style="{StaticResource ReportChoice}"
                                                     ToolTip="What Windows Defender has caught, with each threat named and what was done about it.">
                                            <TextBlock Text="Defender detections" Style="{StaticResource ChoiceTitle}" />
                                        </ListBoxItem>
                                    </ListBox>
                                </DockPanel>

                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                                    <RichTextBox x:Name="HuntOutput" IsReadOnly="True"
                                                 BorderThickness="0" Background="Transparent"
                                                 Foreground="{DynamicResource TextPrimary}"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 IsDocumentEnabled="True" />
                                </Border>
                            </Grid>
                        </TabItem>

                    </TabControl>
                </Grid>

                <!-- ===================== SECURITY TOOLS ===================== -->
                <!--
                    The tools that make or check something: keys, file hashes and
                    passwords. They examine nothing on the machine, which is why they
                    are not on the Audit page.
                -->
                <Grid x:Name="PageSecurityTools" Margin="24,20" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Tools" Style="{StaticResource Heading}" />
                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="Generate SSH keys, passwords and ports, check a download against its published hash, and work out permissions, patterns, timestamps and encodings. Nothing here changes the machine." />
                    </StackPanel>

                    <!--
                        A list by category rather than tabs: a row of twenty tabs
                        wraps into a wall nobody reads. The list and the table in
                        ToolsPage.ps1 (Get-TkToolEntry) name the same tools in the
                        same order, which a test checks. Each tool is a panel of
                        its own, shown when it is chosen.
                    -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0" x:Name="ToolChoices" Background="Transparent" BorderThickness="0" Margin="0,0,16,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ToolTipService.InitialShowDelay="450" ToolTipService.ShowDuration="30000">
                            <ListBoxItem Style="{StaticResource ChoiceGroup}">
                                <TextBlock Text="SECURITY" Style="{StaticResource ChoiceGroupTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Generate passwords and passphrases, see how long one takes to crack, and check it against known breaches.">
                                <TextBlock Text="Passwords" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Generate an ed25519, ECDSA or RSA key pair, list the keys and copy a public key.">
                                <TextBlock Text="SSH keys" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Hash a file, compare it with the hash its vendor publishes, and look it up on VirusTotal.">
                                <TextBlock Text="File integrity" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Decode Microsoft Defender Safe Links in a link or a whole e-mail, to see where they lead without opening them.">
                                <TextBlock Text="Safe Links" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Read the headers of a suspicious e-mail: its route and delays, the sender's addresses, and what SPF, DKIM and DMARC concluded.">
                                <TextBlock Text="E-mail headers" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Check the MX, SPF, DKIM and DMARC records of a domain, and count the DNS lookups its SPF record needs.">
                                <TextBlock Text="Mail DNS records" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Decode a certificate, a chain or a certificate request: names, validity, key, purposes and fingerprints.">
                                <TextBlock Text="Certificates" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Paste a site's response headers and grade its security headers: HSTS, CSP, framing, sniffing, referrer, cookies.">
                                <TextBlock Text="HTTP headers" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>

                            <ListBoxItem Style="{StaticResource ChoiceGroup}">
                                <TextBlock Text="GENERATORS" Style="{StaticResource ChoiceGroupTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Random ports that are free on this machine and outside the ranges Windows reserves.">
                                <TextBlock Text="Ports" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Random version 4 and time ordered version 7 UUIDs, and what a UUID or GUID says about itself.">
                                <TextBlock Text="UUIDs" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Turn a link or a text into a QR code, drawn on this machine, to save as a picture or copy.">
                                <TextBlock Text="QR code" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="A QR code that joins a Wi-Fi network when a phone scans it, for guests or a meeting room.">
                                <TextBlock Text="Wi-Fi QR code" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>

                            <ListBoxItem Style="{StaticResource ChoiceGroup}">
                                <TextBlock Text="TEXT AND DATA" Style="{StaticResource ChoiceGroupTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Base64, URL, HTML and hexadecimal both ways, and JSON Web Token decoding.">
                                <TextBlock Text="Encoding" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Test a .NET regular expression: its matches, groups and replacement, as you type.">
                                <TextBlock Text="Regex" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Unix, FILETIME and Active Directory timestamps, and dates, in every form.">
                                <TextBlock Text="Timestamps" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Format, minify or validate JSON, and turn it into YAML or CSV.">
                                <TextBlock Text="JSON and YAML" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="A number in binary, octal, decimal and hexadecimal, and the bits it sets.">
                                <TextBlock Text="Number bases" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Convert a data size across units and work out how long a transfer takes at a given link speed.">
                                <TextBlock Text="Data size and rate" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Compare two texts line by line, such as two versions of a configuration file.">
                                <TextBlock Text="Text diff" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Take a link apart: host, port, path, every query parameter decoded, and the tricks phishing links use.">
                                <TextBlock Text="URL parser" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Spell out a serial number, a licence key or a password to dictate with the NATO phonetic alphabet.">
                                <TextBlock Text="NATO alphabet" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Read a phone number written in any form and write it as E.164, international, national and a tel: link.">
                                <TextBlock Text="Phone numbers" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Write formatted text and get clean HTML for a signature, a ticket or a wiki, or clean up HTML pasted from elsewhere.">
                                <TextBlock Text="HTML editor" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>

                            <ListBoxItem Style="{StaticResource ChoiceGroup}">
                                <TextBlock Text="LINUX AND DEVOPS" Style="{StaticResource ChoiceGroupTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Unix permissions as check boxes, octal and symbolic forms, and both chmod commands.">
                                <TextBlock Text="chmod" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Write or read a crontab schedule: what it means in words and when it runs next.">
                                <TextBlock Text="Crontab" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Turn a docker run command into the Compose service it describes.">
                                <TextBlock Text="Docker Compose" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>

                            <ListBoxItem Style="{StaticResource ChoiceGroup}">
                                <TextBlock Text="WINDOWS AND AD" Style="{StaticResource ChoiceGroupTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Read an SDDL security descriptor: owner, group, and each access control entry with its rights and trustee named.">
                                <TextBlock Text="SDDL" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Break a userAccountControl, groupType or msDS-SupportedEncryptionTypes value into the bits it sets.">
                                <TextBlock Text="AD account flags" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Build a robocopy command from its options, and read what a robocopy exit code means.">
                                <TextBlock Text="Robocopy" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Build a schtasks /create command line from a schedule and a program.">
                                <TextBlock Text="Scheduled task" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Build a dsacls command that delegates control on an OU, the same as the Delegation of Control wizard.">
                                <TextBlock Text="dsacls delegation" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource ReportChoice}"
                                         ToolTip="Build an event log query from a log, event ids, level and time: as a Get-WinEvent FilterHashtable, an XPath filter and a wevtutil command.">
                                <TextBlock Text="Event log query" Style="{StaticResource ChoiceTitle}" />
                            </ListBoxItem>
                        </ListBox>

                        <Grid Grid.Column="1">

                            <Grid x:Name="ToolSshKeys" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Generate a key pair" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,4">
                                            <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="SshKeyName" Tag="Key file name" Width="160" Text="id_ed25519" Margin="0,0,16,8" />
                                            <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <ComboBox x:Name="SshKeyType" Width="110" Margin="0,0,16,8" />
                                            <TextBlock Text="Comment" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="SshKeyComment" Tag="Comment identifying the key" Width="200" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="Passphrase" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <PasswordBox x:Name="SshPassphrase" Width="220" Margin="0,0,16,8" />
                                            <CheckBox x:Name="SshNoPassphrase" Content="No passphrase (not recommended)" VerticalAlignment="Center" Margin="0,0,16,8" />
                                            <Button x:Name="BtnGenerateSshKey" Content="Generate" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                            <Button x:Name="BtnListSshKeys"    Content="List keys" Margin="0,0,8,8" />
                                            <Button x:Name="BtnCopyPublicKey"  Content="Copy public key" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="ed25519 is the default. An existing key is never overwritten, and the private key permissions are restricted to the owner after generation." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="SshOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>

                            <Grid x:Name="ToolFileIntegrity" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Check a file" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,4">
                                            <TextBlock Text="File" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="HashFilePath" Tag="Path to the file to hash" Width="380" Margin="0,0,8,8" />
                                            <Button x:Name="BtnBrowseHashFile" Content="Browse" Margin="0,0,8,8" />
                                            <Button x:Name="BtnComputeHash"    Content="Compute hashes" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="Expected hash" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="ExpectedHash" Tag="Paste the hash published by the vendor" Width="380" Margin="0,0,8,8" />
                                            <Button x:Name="BtnVerifyHash" Content="Verify" Margin="0,0,8,8" />
                                            <Button x:Name="BtnVirusTotal" Content="Check on VirusTotal" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="The VirusTotal check sends the SHA256 only. The file itself is never uploaded, so internal documents and installers stay private." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="IntegrityOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>

                            <Grid x:Name="ToolPasswords" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Generate" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,4">
                                            <TextBlock Text="Length" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="PasswordLength" Tag="Length" Width="60" Text="20" Margin="0,0,14,8" />
                                            <CheckBox x:Name="PwdUpper"   Content="A-Z" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,8" />
                                            <CheckBox x:Name="PwdLower"   Content="a-z" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,8" />
                                            <CheckBox x:Name="PwdDigits"  Content="0-9" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,8" />
                                            <CheckBox x:Name="PwdSymbols" Content="Symbols" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,8" />
                                            <Button x:Name="BtnGeneratePassword"   Content="Generate password" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                            <Button x:Name="BtnGeneratePassphrase" Content="Generate passphrase" Margin="0,0,8,8" />
                                            <Button x:Name="BtnCopyPassword" Content="Copy last generated" Margin="0,0,0,8" />
                                        </WrapPanel>

                                        <TextBlock Text="Check a password" Style="{StaticResource SubHeading}" Margin="0,8,0,8" />
                                        <WrapPanel>
                                            <PasswordBox x:Name="BreachPassword" Width="260" Margin="0,0,10,8" />
                                            <Button x:Name="BtnAnalysePassword" Content="Analyse strength" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                            <Button x:Name="BtnCheckBreach" Content="Check against breaches" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <TextBlock x:Name="PasswordStrengthMeter" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Text="Type a password to see how strong it is." />
                                        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                                   Text="Strength is worked out on this machine and the password is never shown. The breach check uses k-anonymity: only the first five characters of the SHA1 hash are sent, so the password does not leave the machine either." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="CredentialOutput" Style="{StaticResource Mono}"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                             AcceptsReturn="True" TextWrapping="Wrap" />
                                </Border>
                            </Grid>

                            <Grid x:Name="ToolPorts" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Random ports" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <WrapPanel>
                                            <TextBlock Text="Range" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <ComboBox x:Name="PortRange" Width="250" MinHeight="40" Margin="0,0,16,8" />
                                            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="PortFrom" Width="80" Text="20000" Margin="0,0,12,8" />
                                            <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="PortTo" Width="80" Text="29999" Margin="0,0,16,8" />
                                            <TextBlock Text="How many" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox x:Name="PortCount" Width="60" Text="5" Margin="0,0,0,8" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <CheckBox x:Name="PortSkipInUse" Content="Leave out ports in use or reserved here" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            <CheckBox x:Name="PortSkipKnown" Content="Leave out known service ports" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            <Button x:Name="BtnGeneratePorts" Content="Generate" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                            <Button x:Name="BtnCopyPorts" Content="Copy" />
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Text="Drawn with the cryptographic random generator. The dynamic range is the one IANA and Windows leave to private and temporary use. Ports reserved by Hyper-V, WSL or Docker are read from Windows and left out: a service cannot listen on them. A port free here can still be taken on another machine." />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                                    <TextBox x:Name="PortOutput" Style="{StaticResource Mono}" IsReadOnly="True"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             AcceptsReturn="True" />
                                </Border>
                            </Grid>

                            <Grid x:Name="ToolChmod" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Unix permissions" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <Grid Margin="0,0,0,8" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Read (4)" Style="{StaticResource Muted}" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Write (2)" Style="{StaticResource Muted}" />
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Execute (1)" Style="{StaticResource Muted}" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Owner (u)" VerticalAlignment="Center" Margin="0,6,0,0" />
                                            <CheckBox  Grid.Row="1" Grid.Column="1" x:Name="ChmodOwnerRead" Margin="0,6,0,0" />
                                            <CheckBox  Grid.Row="1" Grid.Column="2" x:Name="ChmodOwnerWrite" Margin="0,6,0,0" />
                                            <CheckBox  Grid.Row="1" Grid.Column="3" x:Name="ChmodOwnerExecute" Margin="0,6,0,0" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Group (g)" VerticalAlignment="Center" Margin="0,6,0,0" />
                                            <CheckBox  Grid.Row="2" Grid.Column="1" x:Name="ChmodGroupRead" Margin="0,6,0,0" />
                                            <CheckBox  Grid.Row="2" Grid.Column="2" x:Name="ChmodGroupWrite" Margin="0,6,0,0" />
                                            <CheckBox  Grid.Row="2" Grid.Column="3" x:Name="ChmodGroupExecute" Margin="0,6,0,0" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Others (o)" VerticalAlignment="Center" Margin="0,6,0,0" />
                                            <CheckBox  Grid.Row="3" Grid.Column="1" x:Name="ChmodOthersRead" Margin="0,6,0,0" />
                                            <CheckBox  Grid.Row="3" Grid.Column="2" x:Name="ChmodOthersWrite" Margin="0,6,0,0" />
                                            <CheckBox  Grid.Row="3" Grid.Column="3" x:Name="ChmodOthersExecute" Margin="0,6,0,0" />
                                        </Grid>
                                        <WrapPanel Margin="0,0,0,8">
                                            <CheckBox x:Name="ChmodSetUid" Content="setuid (4000)" Margin="0,0,16,0" />
                                            <CheckBox x:Name="ChmodSetGid" Content="setgid (2000)" Margin="0,0,16,0" />
                                            <CheckBox x:Name="ChmodSticky" Content="sticky (1000)" Margin="0,0,16,0" />
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="Octal" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox x:Name="ChmodOctal" Width="80" Margin="0,0,16,0" />
