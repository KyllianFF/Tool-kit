                            <Grid x:Name="ToolEventQuery" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Event log query builder" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,4">
                                            <TextBlock Text="Log" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <ComboBox x:Name="EventQueryPreset" Width="150" MinHeight="40" Margin="0,0,8,8" />
                                            <TextBox x:Name="EventQueryLog" Width="360" Margin="0,0,0,8"
                                                     FontFamily="Cascadia Mono, Consolas, Courier New" Text="System" />
