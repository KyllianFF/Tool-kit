                                        <WrapPanel Margin="0,0,0,4">
                                            <TextBlock Text="Schedule" VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <ComboBox x:Name="SchtaskSchedule" Width="130" MinHeight="40" Margin="0,0,16,8" />
