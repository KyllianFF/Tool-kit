                            <Grid x:Name="ToolDsacls" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="dsacls delegation builder" Style="{StaticResource SubHeading}" Margin="0,0,0,8" />
                                        <WrapPanel Margin="0,0,0,4" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="20000">
                                            <TextBlock Text="Object (OU)" VerticalAlignment="Center" Margin="0,0,8,8"
                                                       ToolTip="The distinguished name of the object the rights are set on, usually an OU." />
